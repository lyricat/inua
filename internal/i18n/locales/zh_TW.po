#: internal/games/fortune.go:760
msgid "The fountain is empty."
msgstr "噴泉是空的。"

#: internal/games/fortune.go:763
msgid "%s goes to jail."
msgstr "%s入獄。"

#: internal/games/fortune.go:787
msgid "A double: roll again."
msgstr "雙：再次滾動。"

#: internal/games/fortune.go:802
msgid "A street fair pays out: collect $60."
msgstr "街頭市集支付：收取60美元。"

#: internal/games/fortune.go:803
msgid "Advance to Start."
msgstr "提前開始。"

#: internal/games/fortune.go:804
msgid "Your bicycle needs a new chain: pay $40."
msgstr "您的自行車需要新鏈條：支付 40 美元。"

#: internal/games/fortune.go:805
msgid "Go back three squares."
msgstr "回傳三個方格。"

#: internal/games/fortune.go:806
msgid "It is your birthday: every player gives you $25."
msgstr "今天是你的生日：每個玩家給你 25 美元。"

#: internal/games/fortune.go:807
msgid "Roof repairs: pay $25 for each building."
msgstr "屋頂維修：每棟建築支付25美元。"

#: internal/games/fortune.go:808
msgid "A refund from the tax office: collect $80."
msgstr "稅務局退款：收取 80 美元。"

#: internal/games/fortune.go:809
msgid "Catch a ride to the next station or pier."
msgstr "搭車前往下一站或碼頭。"

#: internal/games/fortune.go:810
msgid "A night out: go to %s."
msgstr "晚上外出：去%s。"

#: internal/games/fortune.go:811
msgid "Your shares paid a dividend: collect $100."
msgstr "您的股票已支付股息：收取 100 美元。"

#: internal/games/fortune.go:812
msgid "Hotel inspection: pay $40 for each building."
msgstr "飯店考察：每棟大樓繳40美元。"

#: internal/games/fortune.go:813
msgid "A parking fine: pay $30."
msgstr "停車罰款：繳30美元。"

#: internal/games/fortune.go:814
msgid "You won a crossword: collect $50."
msgstr "您贏得了一個填字遊戲：收集 50 美元。"

#: internal/games/fortune.go:815
msgid "Buy everyone lunch: pay each player $15."
msgstr "為每個人買午餐：支付每位玩家15美元。"

#: internal/games/fortune.go:816
msgid "Caught jaywalking: go to jail."
msgstr "亂穿馬路被抓：入獄。"

#: internal/games/fortune.go:817
msgid "A card left on a bench: take it."
msgstr "長椅上落下一張卡牌：拿走它。"

#: internal/games/fortune.go:818
msgid "The shopkeeper owes you a favour: take a card."
msgstr "店主欠你一個人情：拿一張卡牌。"

#: internal/games/fortune.go:819
msgid "You won a raffle: take a card."
msgstr "你抽獎中獎了：拿一張卡牌。"

#: internal/games/fortune.go:848
msgid "Chance for %s: %s"
msgstr "%[1]s 的機會:%[2]s"

#: internal/games/fortune.go:851
msgid "%s takes a card: %s."
msgstr "%s 拿到一張卡牌：%s。"

#: internal/games/fortune.go:948
msgid "%s sold a house on %s for $%d."
msgstr "%[1]s 以$%[3]d 的價格出售了 %[2]s 上的房子。"

#: internal/games/fortune.go:952
msgid "%s sold %s to the bank for $%d."
msgstr "%[1]s以$%[3]d的價格將%[2]s賣給銀行。"

#: internal/games/fortune.go:966
msgid "%s is bankrupt and out of the game."
msgstr "%s破產並退出遊戲。"

#: internal/games/fortune.go:1001
msgid "%s sleeps through their turn."
msgstr "%s 睡過了這一回合。"

#: internal/games/fortune.go:1021
msgid "%s won with $%d in worth."
msgstr "%[1]s 獲勝,價值 $%[2]d。"

#: internal/games/fortune_cards.go:53
msgid "Loaded Dice"
msgstr "灌鉛骰子"

#: internal/games/fortune_cards.go:53
msgid "Before you roll: walk the number of squares you choose instead. At a fork, chance still picks the road."
msgstr "擲骰前：改為走你選擇的格數。在岔路口，仍由運氣選路。"

#: internal/games/fortune_cards.go:54
msgid "Free Rent"
msgstr "免租"

#: internal/games/fortune_cards.go:54
msgid "The next rent you owe is not paid."
msgstr "下一次應付的租金免付。"

#: internal/games/fortune_cards.go:55
msgid "Requisition"
msgstr "強制徵購"

#: internal/games/fortune_cards.go:55
msgid "Buy the rival's property you stand on, buildings and all, paying its owner what it cost."
msgstr "買下你所在的對手地產（連同建築），向其主人支付它的成本。"

#: internal/games/fortune_cards.go:56
msgid "Pickpocket"
msgstr "扒手"

#: internal/games/fortune_cards.go:56
msgid "Take a card, at random, from a rival's hand."
msgstr "從對手手中隨機拿走一張卡牌。"

#: internal/games/fortune_cards.go:57
msgid "Demolition"
msgstr "拆除"

#: internal/games/fortune_cards.go:57
msgid "Pull down a building on a rival's street: pick the street on the board first."
msgstr "拆掉對手街道上的一棟建築：先在棋盤上選好街道。"

#: internal/games/fortune_cards.go:58
msgid "Building Permit"
msgstr "建築許可"

#: internal/games/fortune_cards.go:58
msgid "Put up a building on a street of yours, free: pick the street on the board first."
msgstr "在你的街道上免費建一棟建築：先在棋盤上選好街道。"

#: internal/games/fortune_cards.go:59
msgid "Turtle"
msgstr "烏龜"

#: internal/games/fortune_cards.go:59
msgid "A player of your choice walks one square a roll for their next three rolls."
msgstr "你選擇的玩家在接下來三次擲骰中每次只走一格。"

#: internal/games/fortune_cards.go:60
msgid "Swap Places"
msgstr "交換位置"

#: internal/games/fortune_cards.go:60
msgid "Change places with a rival; neither of you lands anywhere."
msgstr "與一名對手交換位置；雙方都不算停在任何格子上。"

#: internal/games/fortune_cards.go:61
msgid "Jail Pass"
msgstr "出獄卡"

#: internal/games/fortune_cards.go:61
msgid "Walk out of jail before you roll, without paying bail."
msgstr "擲骰前出獄，無需支付保釋金。"

#: internal/games/fortune_cards.go:62
msgid "Tax Audit"
msgstr "稅務稽查"

#: internal/games/fortune_cards.go:62
msgid "A rival pays a tenth of their cash into the fountain."
msgstr "一名對手把十分之一的現金交進噴泉。"

#: internal/games/fortune_cards.go:63
msgid "Fair Shares"
msgstr "平分財富"

#: internal/games/fortune_cards.go:63
msgid "Everyone's cash is pooled and shared out equally."
msgstr "所有人的現金匯總後平均分配。"

#: internal/games/fortune_cards.go:64
msgid "Sleeping Pill"
msgstr "安眠藥"

#: internal/games/fortune_cards.go:64
msgid "A rival misses their next turn."
msgstr "一名對手跳過下一回合。"

