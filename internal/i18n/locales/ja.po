msgstr "%s が %s を使いました: %d マス。"

#: internal/games/fortune_cards.go:258
msgid "%s played %s: no rent next time."
msgstr "%s が %s を使いました: 次の家賃は免除。"

#: internal/games/fortune_cards.go:265
msgid "%s played %s and took %s from %s for $%d."
msgstr "%[1]s が %[2]s を使い、%[4]s から %[3]s を $%[5]d で手に入れました。"

#: internal/games/fortune_cards.go:274
msgid "%s played %s and took %s from %s."
msgstr "%[1]s が %[2]s を使い、%[4]s から %[3]s を取りました。"

#: internal/games/fortune_cards.go:276
#: internal/games/fortunenet/texts.go:82
