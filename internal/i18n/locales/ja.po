#: internal/games/fortune_cards.go:284
msgid "%s played %s: a building goes up on %s."
msgstr "%s が %s を使いました: %s に建物が建ちました。"

#: internal/games/fortune_cards.go:287
msgid "%s played %s: %s walks one square a roll for three rolls."
msgstr "%s が %s を使いました: %s は 3 回のあいだ 1 回に 1 マスしか進めません。"

#: internal/games/fortune_cards.go:290
msgid "%s played %s and changed places with %s."
msgstr "%s が %s を使い、%s と位置を入れ替えました。"

#: internal/games/fortune_cards.go:295
msgid "%s played %s and walked out of jail."
msgstr "%s が %s を使い、刑務所を出ました。"

#: internal/games/fortune_cards.go:299
msgid "%s played %s: %s pays $%d into the fountain."
msgstr "%s が %s を使いました: %s が噴水に $%d を払います。"

#: internal/games/fortune_cards.go:314
msgid "%s played %s: everyone now has $%d."
msgstr "%s が %s を使いました: 全員の所持金が $%d になりました。"

#: internal/games/fortune_cards.go:317
msgid "%s played %s: %s sits out the next turn."
