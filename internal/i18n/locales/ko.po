msgstr "게임 설정 담당"

#: internal/games/checkersnet/texts.go:39
#: internal/gamesui/checkers.go:1036
msgid "away, the computer plays"
msgstr "자리 비움, 컴퓨터가 대신 합니다"

#: internal/games/checkersnet/texts.go:40
#: internal/gamesui/checkers.go:346
msgid "Stay out of other points"
msgstr "다른 꼭짓점에 멈추지 않기"

#: internal/games/checkersnet/texts.go:41
#: internal/gamesui/checkers.go:346
msgid "A marble may cross another player's point, but not stop in it."
msgstr "구슬은 다른 사람의 꼭짓점을 지나갈 수는 있지만 그곳에 멈출 수는 없습니다."

#: internal/games/checkersnet/texts.go:42
#: internal/games/fortunenet/texts.go:102
#: internal/gamesui/checkers.go:379
#: internal/gamesui/fortune_host.go:329
