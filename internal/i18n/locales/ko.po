#: internal/games/fortunenet/texts.go:47
#: internal/gamesui/checkers.go:1000
#: internal/gamesui/checkers.go:1007
#: internal/gamesui/fortune_board.go:1113
msgid "%s's turn"
msgstr "%s의 차례"

#: internal/games/checkersnet/texts.go:46
#: internal/gamesui/checkers.go:998
msgid "Your turn: pick one of your marbles."
msgstr "당신 차례입니다. 내 구슬 하나를 고르세요."

#: internal/games/checkersnet/texts.go:47
#: internal/gamesui/checkers.go:1003
msgid "You are home: move %s's marbles."
msgstr "도착했습니다. %s 님의 구슬을 움직이세요."

#: internal/games/checkersnet/texts.go:48
msgid "Now pick where it goes, or another marble."
msgstr "이제 갈 곳을 고르거나 다른 구슬을 고르세요."

#: internal/games/checkersnet/texts.go:49
msgid "home"
msgstr "도착"

#: internal/games/checkersnet/texts.go:50
#: internal/gamesui/checkers.go:1034
msgid "#%d home"
msgstr "%d번째로 도착"

#: internal/games/checkersnet/texts.go:51
#: internal/gamesui/checkers.go:1031
msgid "%d to go"
msgstr "%d 남음"

#: internal/games/checkersnet/texts.go:52
msgid "%d hops"
msgstr "%d번 점프"

#: internal/games/checkersnet/texts.go:53
#: internal/gamesui/checkers.go:933
msgid "%s moved"
msgstr "%s 님이 움직였습니다"

#: internal/games/checkersnet/texts.go:54
#: internal/gamesui/checkers.go:931
msgid "%s hopped %d times"
msgstr "%s 님이 %d번 연속 점프"

#: internal/games/checkersnet/texts.go:55
#: internal/gamesui/checkers.go:929
msgid "%s moved %s's marble"
msgstr "%s 님이 %s 님의 구슬을 움직였습니다"

#: internal/games/checkersnet/texts.go:56
#: internal/gamesui/checkers.go:936
msgid "%s could not move"
msgstr "%s 님은 움직일 수 없었습니다"

#: internal/games/checkersnet/texts.go:57
#: internal/gamesui/checkers.go:938
msgid "%s is home"
msgstr "%s 님이 모두 도착했습니다"

#: internal/games/checkersnet/texts.go:58
#: internal/gamesui/checkers.go:963
msgid "%s wins"
msgstr "%s 님 승리"

#: internal/games/checkersnet/texts.go:59
#: internal/gamesui/checkers.go:969
msgid "%s win"
msgstr "%s 승리"

#: internal/games/checkersnet/texts.go:60
#: internal/gamesui/checkers.go:967
#: internal/gamesui/fortune.go:595
msgid "%s and %s"
msgstr "%[1]s 및 %[2]s"

#: internal/games/checkersnet/texts.go:61
#: internal/gamesui/checkers.go:942
#: internal/gamesui/checkers.go:996
msgid "No one got home in time: a draw."
msgstr "제때 아무도 도착하지 못했습니다. 무승부입니다."

#: internal/games/checkersnet/texts.go:62
msgid "The game is over."
msgstr "게임이 끝났습니다."

#: internal/games/checkersnet/texts.go:63
msgid "Drag to turn the board, scroll to come closer."
msgstr "드래그하여 판을 돌리고, 스크롤하여 가까이 봅니다."

#: internal/games/fortune.go:54
#: internal/games/fortunenet/texts.go:62
