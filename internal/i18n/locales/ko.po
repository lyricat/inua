msgstr "시작"

#: internal/games/fortune.go:66
#: internal/gamesui/fortune_menu.go:181
msgid "Income Tax"
msgstr "소득세"

#: internal/games/fortune.go:70
#: internal/gamesui/fortune_menu.go:173
msgid "Jail"
msgstr "감옥"

#: internal/games/fortune.go:75
#: internal/gamesui/fortune_menu.go:174
msgid "Fountain"
msgstr "분수"

#: internal/games/fortune.go:80
#: internal/gamesui/fortune_menu.go:175
msgid "Go to Jail"
msgstr "감옥에 가다"

#: internal/games/fortune.go:84
msgid "Luxury Tax"
msgstr "사치세"

#: internal/games/fortune.go:314
#: internal/gamesui/fortune.go:681
msgid "You"
msgstr "당신"

#: internal/games/fortune.go:329
#: internal/gamesui/checkers.go:594
#: internal/gamesui/fortune.go:677
#: internal/gamesui/fortune_host.go:44
msgid "Player %d"
msgstr "플레이어 %d"

#: internal/games/fortune.go:502
msgid "a house"
msgstr "집"

#: internal/games/fortune.go:504
msgid "a hotel"
msgstr "호텔"

#: internal/games/fortune.go:506
msgid "%s built %s on %s ($%d)."
msgstr "%[1]s는 %[3]s($%[4]d)에 %[2]s를 구축했습니다."

#: internal/games/fortune.go:517
msgid "%s sold a building on %s for $%d."
msgstr "%[1]s는 %[2]s에 있는 건물을 $%[3]d에 매각했습니다."

#: internal/games/fortune.go:555
msgid "%s paid $%d bail."
msgstr "%[1]s는 $%[2]d 보석금을 지불했습니다."

#: internal/games/fortune.go:591
#: internal/games/fortune_cards.go:136
msgid "%s bought %s for $%d."
msgstr "%[1]s는 $%[3]d에 %[2]s를 구입했습니다."

#: internal/games/fortune.go:605
#: internal/games/fortunenet/texts.go:106
#: internal/gamesui/fortune_menu.go:173
#: internal/gamesui/fortune_panel.go:276
msgid "a double"
msgstr "더블"

#: internal/games/fortune.go:607
#: internal/games/fortunenet/texts.go:107
#: internal/gamesui/fortune_panel.go:276
msgid "a six"
msgstr "6"

#: internal/games/fortune.go:609
msgid "%s rolled %s and walked out of jail."
msgstr "%[1]s는 %[2]s를 굴려 감옥에서 나왔습니다."

#: internal/games/fortune.go:612
msgid "%s stays in jail."
msgstr "%s는 감옥에 갇혀 있다."

#: internal/games/fortune.go:616
msgid "%s paid $%d bail after three tries."
msgstr "%[1]s는 세 번의 시도 끝에 $%[2]d의 보석금을 지불했습니다."

#: internal/games/fortune.go:625
msgid "%s is a turtle: one square."
msgstr "%s은(는) 거북이입니다: 한 칸."

#: internal/games/fortune.go:630
msgid "Three doubles in a row: %s goes to jail."
msgstr "세 번의 연속 복식: %s가 감옥에 갑니다."

#: internal/games/fortune.go:691
msgid "%s took the road through %s."
msgstr "%[1]s는 %[2]s를 통과하는 길을 택했습니다."

#: internal/games/fortune.go:694
msgid "%s passed Start: +$%d."
msgstr "%[1]s는 시작: +$%[2]d를 통과했습니다."

#: internal/games/fortune.go:737
msgid "%s cannot afford %s."
msgstr "%[1]s는 %[2]s를 감당할 수 없습니다."

#: internal/games/fortune.go:741
msgid "%s owed %s rent for %s and paid nothing: Free Rent."
msgstr "%[1]s은(는) %[3]s의 임대료를 %[2]s에게 내야 했지만 아무것도 내지 않았습니다: 임대료 면제."

#: internal/games/fortune.go:747
msgid "%s paid %s $%d rent for %s."
msgstr "%[1]s는 %[4]s에 대해 %[2]s $%[3]d 임대료를 지불했습니다."

#: internal/games/fortune.go:753
msgid "%s paid $%d %s into the fountain."
msgstr "%[1]s는 $%[2]d %[3]s를 분수에 지불했습니다."

#: internal/games/fortune.go:756
msgid "%s took $%d from the fountain."
msgstr "%[1]s는 분수에서 $%[2]d를 가져갔습니다."

#: internal/games/fortune.go:760
msgid "The fountain is empty."
msgstr "분수는 비어 있다."

#: internal/games/fortune.go:763
msgid "%s goes to jail."
msgstr "%s는 감옥에 간다."

#: internal/games/fortune.go:787
msgid "A double: roll again."
msgstr "더블: 다시 굴린다."

#: internal/games/fortune.go:802
msgid "A street fair pays out: collect $60."
msgstr "거리 박람회는 보상을 받습니다: $60를 모금합니다."

#: internal/games/fortune.go:803
msgid "Advance to Start."
msgstr "시작으로 진행합니다."

#: internal/games/fortune.go:804
msgid "Your bicycle needs a new chain: pay $40."
msgstr "귀하의 자전거에는 새로운 체인이 필요합니다. 비용은 $40입니다."

#: internal/games/fortune.go:805
msgid "Go back three squares."
msgstr "세 칸 뒤로 이동합니다."

#: internal/games/fortune.go:806
msgid "It is your birthday: every player gives you $25."
msgstr "당신의 생일입니다. 모든 플레이어가 당신에게 $25를 줍니다."

#: internal/games/fortune.go:807
msgid "Roof repairs: pay $25 for each building."
msgstr "지붕 수리: 건물당 $25를 지불합니다."

#: internal/games/fortune.go:808
msgid "A refund from the tax office: collect $80."
msgstr "세무서로부터의 환급금: $80를 징수합니다."

#: internal/games/fortune.go:809
msgid "Catch a ride to the next station or pier."
msgstr "다음 역이나 부두까지 차를 타세요."

#: internal/games/fortune.go:810
msgid "A night out: go to %s."
msgstr "밤 외출: %s로 가세요."

#: internal/games/fortune.go:811
msgid "Your shares paid a dividend: collect $100."
msgstr "귀하의 주식은 배당금을 지불했습니다. 100달러를 모았습니다."

#: internal/games/fortune.go:812
msgid "Hotel inspection: pay $40 for each building."
msgstr "호텔 검사: 각 건물에 대해 $40를 지불합니다."

#: internal/games/fortune.go:813
msgid "A parking fine: pay $30."
msgstr "주차 벌금: $30 지불."

#: internal/games/fortune.go:814
msgid "You won a crossword: collect $50."
msgstr "당신은 십자말 풀이에 당첨되어 $50를 모았습니다."

#: internal/games/fortune.go:815
msgid "Buy everyone lunch: pay each player $15."
msgstr "모두에게 점심 구매: 각 플레이어에게 $15를 지불합니다."

#: internal/games/fortune.go:816
msgid "Caught jaywalking: go to jail."
msgstr "무단횡단하다 적발되어 감옥에 갑니다."

#: internal/games/fortune.go:817
msgid "A card left on a bench: take it."
msgstr "벤치에 놓인 카드: 가져가세요."

#: internal/games/fortune.go:818
msgid "The shopkeeper owes you a favour: take a card."
msgstr "가게 주인이 신세를 갚습니다: 카드를 한 장 가져가세요."

#: internal/games/fortune.go:819
msgid "You won a raffle: take a card."
msgstr "추첨에 당첨되었습니다: 카드를 한 장 가져가세요."

#: internal/games/fortune.go:848
msgid "Chance for %s: %s"
msgstr "%[1]s에 대한 기회: %[2]s"

#: internal/games/fortune.go:851
msgid "%s takes a card: %s."
msgstr "%s이(가) 카드를 받았습니다: %s."

#: internal/games/fortune.go:948
msgid "%s sold a house on %s for $%d."
msgstr "%[1]s는 %[2]s의 집을 $%[3]d에 판매했습니다."

#: internal/games/fortune.go:952
msgid "%s sold %s to the bank for $%d."
msgstr "%[1]s는 %[2]s를 $%[3]d에 은행에 판매했습니다."

#: internal/games/fortune.go:966
msgid "%s is bankrupt and out of the game."
msgstr "%s는 파산하여 게임에서 제외되었습니다."

#: internal/games/fortune.go:1001
msgid "%s sleeps through their turn."
msgstr "%s은(는) 잠들어 차례를 쉽니다."

#: internal/games/fortune.go:1021
msgid "%s won with $%d in worth."
msgstr "%[1]s는 $%[2]d 가치로 승리했습니다."

#: internal/games/fortune_cards.go:53
msgid "Loaded Dice"
msgstr "조작된 주사위"

#: internal/games/fortune_cards.go:53
msgid "Before you roll: walk the number of squares you choose instead. At a fork, chance still picks the road."
msgstr "주사위를 굴리기 전에: 대신 원하는 칸 수만큼 이동합니다. 갈림길에서는 여전히 운이 길을 고릅니다."

#: internal/games/fortune_cards.go:54
msgid "Free Rent"
msgstr "임대료 면제"

#: internal/games/fortune_cards.go:54
msgid "The next rent you owe is not paid."
msgstr "다음에 낼 임대료를 내지 않습니다."

#: internal/games/fortune_cards.go:55
msgid "Requisition"
msgstr "강제 매입"

#: internal/games/fortune_cards.go:55
msgid "Buy the rival's property you stand on, buildings and all, paying its owner what it cost."
msgstr "지금 서 있는 상대의 부동산을 건물째 사들이고, 소유자에게 든 비용을 지불합니다."

#: internal/games/fortune_cards.go:56
msgid "Pickpocket"
msgstr "소매치기"

#: internal/games/fortune_cards.go:56
msgid "Take a card, at random, from a rival's hand."
msgstr "상대의 손패에서 카드 한 장을 무작위로 가져옵니다."

#: internal/games/fortune_cards.go:57
msgid "Demolition"
msgstr "철거"

#: internal/games/fortune_cards.go:57
msgid "Pull down a building on a rival's street: pick the street on the board first."
msgstr "상대 거리의 건물 하나를 철거합니다: 먼저 판에서 거리를 고르세요."

#: internal/games/fortune_cards.go:58
msgid "Building Permit"
msgstr "건축 허가"

#: internal/games/fortune_cards.go:58
msgid "Put up a building on a street of yours, free: pick the street on the board first."
msgstr "내 거리에 건물 하나를 무료로 짓습니다: 먼저 판에서 거리를 고르세요."

#: internal/games/fortune_cards.go:59
msgid "Turtle"
msgstr "거북이"

#: internal/games/fortune_cards.go:59
msgid "A player of your choice walks one square a roll for their next three rolls."
msgstr "고른 플레이어는 다음 세 번 동안 한 번에 한 칸씩만 이동합니다."

#: internal/games/fortune_cards.go:60
msgid "Swap Places"
msgstr "자리 바꾸기"

#: internal/games/fortune_cards.go:60
msgid "Change places with a rival; neither of you lands anywhere."
msgstr "상대와 자리를 바꿉니다. 둘 다 어느 칸에도 멈춘 것으로 치지 않습니다."

#: internal/games/fortune_cards.go:61
msgid "Jail Pass"
msgstr "출소권"

