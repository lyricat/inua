// Top bar, one per monitor: a slim strip with a small screen-edge margin.
// Workspace and tray buttons are added from Go.
using Gtk 4.0;

ApplicationWindow bar {
  styles ["bar"]

  // A panel hangs from the bar inside its window (drop.go), over the
  // island, the window grown down over the screen meanwhile.
  Overlay frame {
    CenterBox island {
      styles ["island"]
      valign: start;
      margin-top: 4;
      margin-start: 4;
      margin-end: 4;
      height-request: 30;

      start-widget: Box {
        spacing: 14;

        // Go puts the workspaces' dots after the widget page's mark, the
        // place before the first workspace: hollow, filled while the page
        // shows; hidden with widgets.enable off.
        Box workspaces {
          styles ["workspaces"]
          spacing: 5;
          valign: center;

          Button widgets {
            styles ["widgets-mark"]
            tooltip-text: _("Engawa");
            focusable: false;
            valign: center;
          }
        }

        // The focused application, always the same way: its icon, its name,
        // then its menus (appmenu.go). The name is a button: it opens the
        // application's own menu, the one every application has (About,
        // Close, Quit), as a Mac's does. Hidden with bar.title = false.
        Button app {
          styles ["app"]
          name: "app";
          has-frame: false;
          focusable: false;

          Box {
            spacing: 8;

            Image app_icon {
              styles ["app-icon"]
              valign: center;
            }

            Label title {
              styles ["title"]
              ellipsize: end;
              max-width-chars: 32;
              valign: center;
            }
          }
        }

        // The focused application's menus (appmenu.go); Go fills it.
        Box app_menu {
          styles ["app-menu"]
          spacing: 2;
        }
      };

      // The clock opens Calendar.
      center-widget: Button clock_button {
        styles ["clock-button"]
        name: "calendar";
        focusable: false;
        tooltip-text:  _("Calendar");

        Label clock {
          styles ["clock"]
        }
      };

      end-widget: Box end {
        spacing: 6;

        Box tray {
          styles ["tray"]
          spacing: 2;
          valign: center;
        }

        // While the screen is being recorded: a red square and the time so
        // far; a click stops the recording.
        Button rec {
          styles ["rec"]
          name: "rec";
          focusable: false;
          visible: false;
          tooltip-text:  _("Stop recording");

          Box {
            spacing: 6;

            Box {
              styles ["rec-mark"]
              valign: center;
            }

            Label rec_time {
              styles ["numeric"]
            }
          }
        }

        // Opens the search through the password store; shown when there is
        // one.
        Button passwords {
          styles ["passwords"]
          name: "passwords";
          focusable: false;
          visible: false;
          tooltip-text: _("Passwords");
          icon-name: "dialog-password-symbolic";
        }

        Button clipboard {
          styles ["clipboard"]
          focusable: false;
          tooltip-text: _("Clipboard history");
          icon-name: "edit-paste-symbolic";
        }

        // Opens the notification center: a bell, a moon while Focus is on,
        // and a square on its corner for unread notifications, so it is as
        // wide as the other icon buttons.
        Button notes {
          styles ["notes"]
          name: "notes";
          focusable: false;
          tooltip-text:  _("Notifications");

          Overlay {
            Image notes_icon {
              icon-name: "preferences-system-notifications-symbolic";
            }

            [overlay]
            Box unread {
              styles ["unread"]
              halign: end;
              valign: start;
              visible: false;
            }
          }
        }

        // Dictation's microphone: what the voxtype daemon is doing. A click
        // toggles a recording, or opens the settings when voxtype is not
        // ready; hidden while dictation is off.
        Button voice {
          styles ["voice"]
          name: "voice";
          focusable: false;
          visible: false;
          tooltip-text: _("Dictation");

          Image voice_icon {
            icon-name: "audio-input-microphone-symbolic";
          }
        }

        // Opens the control center.
        Button status {
          styles ["status"]
          name: "status";
          focusable: false;
          tooltip-text:  _("Control Center");

          Box {
            spacing: 9;

            Image net_icon {
              icon-name: "network-offline-symbolic";
            }

            Image bt_icon {
              icon-name: "bluetooth-disabled-symbolic";
              visible: false;
            }

            Image vol_icon {
              icon-name: "audio-volume-muted-symbolic";
            }

            Box battery {
              spacing: 3;
              visible: false;

              Image bat_icon {
                icon-name: "battery-level-50-symbolic";
              }

              Label bat_label {
                styles ["numeric"]
              }
            }
          }
        }
      };
    }
  }
}
