// Top bar, one per monitor: a slim strip with a small screen-edge margin.
// Workspace and tray buttons are added from Go.
using Gtk 4.0;

ApplicationWindow bar {
  styles ["bar"]

  CenterBox island {
    styles ["island"]
    margin-top: 4;
    margin-start: 4;
    margin-end: 4;
    height-request: 30;

    start-widget: Box {
      spacing: 14;

      Box workspaces {
        styles ["workspaces"]
        spacing: 5;
        valign: center;
      }

      Label title {
        styles ["title"]
        ellipsize: end;
        max-width-chars: 48;
      }
    };

    // The clock opens Calendar.
    center-widget: Button clock_button {
      styles ["clock-button"]
      name: "calendar";
      focusable: false;
      tooltip-text:  _("Calendar");

      Label clock {
        styles ["clock"]
      }
    };

    end-widget: Box {
      spacing: 6;

      Box tray {
        styles ["tray"]
        spacing: 2;
        valign: center;
      }

      // While the screen is being recorded: a red square and the time so
      // far; a click stops the recording.
      Button rec {
        styles ["rec"]
        name: "rec";
        focusable: false;
        visible: false;
        tooltip-text:  _("Stop recording");

        Box {
          spacing: 6;

          Box {
            styles ["rec-mark"]
            valign: center;
          }

          Label rec_time {
            styles ["numeric"]
          }
        }
      }

      // Opens the search through the password store; shown when there is
      // one.
      Button passwords {
        styles ["passwords"]
        name: "passwords";
        focusable: false;
        visible: false;
        tooltip-text: _("Passwords");
        icon-name: "dialog-password-symbolic";
      }

      Button clipboard {
        styles ["clipboard"]
        focusable: false;
        tooltip-text: _("Clipboard history");
        icon-name: "edit-paste-symbolic";
      }

      // Opens the notification center: a bell, a moon while Focus is on,
      // and a square on its corner for unread notifications, so it is as
      // wide as the other icon buttons.
      Button notes {
        styles ["notes"]
        name: "notes";
        focusable: false;
        tooltip-text:  _("Notifications");

        Overlay {
          Image notes_icon {
            icon-name: "preferences-system-notifications-symbolic";
          }

          [overlay]
          Box unread {
            styles ["unread"]
            halign: end;
            valign: start;
            visible: false;
          }
        }
      }

      // The voice input's microphone: what the voxtype daemon is doing.
      // A click toggles a recording; hidden while voice input is off.
      Button voice {
        styles ["voice"]
        name: "voice";
        focusable: false;
        visible: false;
        tooltip-text: _("Voice input");

        Image voice_icon {
          icon-name: "microphone-symbolic";
        }
      }


      // Opens the control center.
      Button status {
        styles ["status"]
        name: "status";
        focusable: false;
        tooltip-text:  _("Control Center");

        Box {
          spacing: 9;

          Image net_icon {
            icon-name: "network-offline-symbolic";
          }

          Image bt_icon {
            icon-name: "bluetooth-disabled-symbolic";
            visible: false;
          }

          Image vol_icon {
            icon-name: "audio-volume-muted-symbolic";
          }

          Box battery {
            spacing: 3;
            visible: false;

            Image bat_icon {
              icon-name: "battery-level-50-symbolic";
            }

            Label bat_label {
              styles ["numeric"]
            }
          }
        }
      }
    };
  }
}
