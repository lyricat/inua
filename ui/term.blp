// inua-term's window (docs/terminal.md): the workspaces, the shown
// workspace's sessions and their panes, and the shown session's
// terminals, tiled. Rows, sections and tiles are made in Go.
using Gtk 4.0;

ApplicationWindow term {
  default-width: 1280;
  default-height: 800;

  // The sheets (actions, agents, keys, renaming) over the whole window.
  Overlay sheets {
    Box {
      // Column 1: the workspaces, sliding away when hidden (its toggle,
      // Ctrl+Shift+B), with the grip at its edge.
      Revealer col1_reveal {
        transition-type: slide_right;
        transition-duration: 200;
        reveal-child: true;

        child: Box {
          Box workspaces_col {
            styles ["index", "term-col1"]
            orientation: vertical;
            hexpand: false;
            width-request: 232;

            // Hiding the column, as Files and Mail do; then finding a
            // workspace (in a row of its own, opened by its button), a new one
            // and the menu.
            Box {
              styles ["term-col-head"]
              spacing: 6;

              Button sidebar_hide {
                styles ["tool"]
                icon-name: "sidebar-show-symbolic";
                valign: center;
              }

              ToggleButton find_button {
                styles ["plain", "term-head-button"]
                icon-name: "system-search-symbolic";
                tooltip-text: _("Find a workspace or agent");
                valign: center;
                hexpand: true;
                halign: end;
              }

              Button new_workspace {
                styles ["plain", "term-head-button"]
                icon-name: "list-add-symbolic";
                valign: center;
              }

              Button menu {
                styles ["plain", "term-head-button"]
                icon-name: "open-menu-symbolic";
                valign: center;
              }
            }

            Revealer find_reveal {
              transition-type: slide_down;
              transition-duration: 160;

              child: Box {
                styles ["term-find-slot", "term-find-row"]

                SearchEntry find {
                  styles ["index-search", "term-find-entry"]
                  hexpand: true;
                  placeholder-text: _("Find a workspace or agent");
                }
              };
            }

            // As tall as its rows, to its most, while the agents show
            // under it; the whole column while they do not (columns.go).
            ScrolledWindow workspaces_scroll {
              vexpand: true;
              hscrollbar-policy: never;
              propagate-natural-height: true;
              max-content-height: 280;

              ListBox workspaces {
                selection-mode: single;
              }
            }

            // Every agent, in three groups that fold as an accordion:
            // needing you or done, working, idle (agentlist.go). It takes
            // the rest of the column, its groups at the foot.
            ScrolledWindow agents_scroll {
              styles ["term-agents"]
              visible: false;
              vexpand: true;
              hscrollbar-policy: never;

              Box agents {
                orientation: vertical;
                valign: end;
              }
            }
          }

          // Dragged, it sets the width of the column before it; Go keeps it.
          Box grip1 {
            styles ["term-col-grip"]
          }
        };
      }

      // Column 2: the shown workspace's sessions, each a section of its
      // panes, and a new session after the last.
      Box sessions_col {
        styles ["index", "term-col2"]
        orientation: vertical;
        hexpand: false;
        width-request: 312;

        // Showing column 1 again, while it is hidden.
        Box sidebar_show_head {
          styles ["term-col-head"]
          visible: false;

          Button sidebar_show {
            styles ["tool"]
            icon-name: "sidebar-show-symbolic";
            valign: center;
          }
        }

        ScrolledWindow {
          vexpand: true;
          hscrollbar-policy: never;

          Box {
            styles ["term-sessions"]
            orientation: vertical;

            Box sessions {
              orientation: vertical;
            }

            Button new_session {
              styles ["term-new-session"]

              Box {
                spacing: 8;
                halign: center;

                Image {
                  icon-name: "list-add-symbolic";
                }

                Label {
                  label: _("New session");
                }
              }
            }
          }
        }
      }

      Box grip2 {
        styles ["term-col-grip"]
      }

      // Column 3: the shown session's panes, tiled, and nothing else.
      Overlay stage {
        hexpand: true;
        vexpand: true;

        Box tiles {
          styles ["term-tiles"]
          hexpand: true;
          vexpand: true;
        }
      }
    }
  }
}
