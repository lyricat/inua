// Calculator: the expression and its result, then the keys. The
// scientific keys sit to the left and show when Scientific is on. Every
// key carries its input in `name`. History
// slides in a panel at the right listing recent calculations; one
// recalls its result.
using Gtk 4.0;

ApplicationWindow calculator {
  default-width: 340;
  default-height: 520;

  Box {
    Box {
      styles ["calc"]
      orientation: vertical;
      hexpand: true;

      Box {
        styles ["calc-modes"]
        spacing: 6;

        ToggleButton sci {
          styles ["framed-toggle"]
          label:  _("Scientific");
        }

        ToggleButton deg {
          styles ["framed-toggle"]
          label:  _("Deg");
          active: true;
          tooltip-text:  _("Trigonometry in degrees (off: radians)");
        }

        Box {
          hexpand: true;
        }

        ToggleButton history {
          styles ["framed-toggle"]
          tooltip-text:  _("Recent calculations");

          Box {
            spacing: 5;

            Image {
              icon-name: "document-open-recent-symbolic";
            }

            Label {
              label:  _("History");
            }
          }
        }
      }

      Box {
        styles ["calc-display"]
        spacing: 8;
        orientation: vertical;
        vexpand: true;
        valign: end;

        Entry expression {
          styles ["calc-expr"]
          xalign: 1;
          width-chars: 1;
          tooltip-text: _("Formula");
          accessibility {
            label: _("Formula");
          }
        }

        Entry result {
          styles ["calc-result"]
          xalign: 1;
          width-chars: 1;
          text: "0";
          tooltip-text: _("Value");
          accessibility {
            label: _("Value");
          }
        }

        Label error {
          styles ["calc-error"]
          visible: false;
          xalign: 0;
          wrap: true;
          selectable: true;
        }
      }

      Box {
        styles ["calc-keys"]
        spacing: 8;
        homogeneous: false;

        Grid scikeys {
          visible: false;
          row-spacing: 8;
          column-spacing: 8;
          row-homogeneous: true;
          column-homogeneous: true;
        }

        Grid keys {
          hexpand: true;
          row-spacing: 8;
          column-spacing: 8;
          row-homogeneous: true;
          column-homogeneous: true;
        }
      }
    }

    Revealer history_reveal {
      transition-type: slide_left;
      transition-duration: 200;

      Box {
        styles ["calc-history"]
        orientation: vertical;
        width-request: 260;

        Label {
          styles ["kicker"]
          label:  _("HISTORY");
          xalign: 0;
        }

        ScrolledWindow {
          hscrollbar-policy: never;
          vexpand: true;

          Box history_list {
            orientation: vertical;
            spacing: 2;
          }
        }

        Button history_clear {
          styles ["framed-toggle"]
          label:  _("Clear history");
          halign: start;
        }
      }
    }
  }
}
