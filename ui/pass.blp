// Pass, the password store, in three columns: the categories (the first
// segment of each entry's path), under the search through every entry,
// with the store in use at the bottom; the chosen category's entries; and
// the chosen entry, or its editor (a row for each line, or the text), or
// the form that renames, moves, creates or deletes. The search's results
// drop down over the columns.
// Go fills them (internal/appui/pass.go).
using Gtk 4.0;

ApplicationWindow pass {
  default-width: 1060;
  default-height: 640;

  Overlay overlay {
    Box columns {
      // --- categories ---
      Box {
        styles ["index"]
        orientation: vertical;
        hexpand: false;
        width-request: 210;

        Label {
          styles ["index-title"]
          label:  _("Pass");
          xalign: 0;
        }

        // The search through every entry; typing anywhere starts it.
        SearchEntry filter {
          styles ["pass-search"]
          placeholder-text:  _("Search every entry");
        }

        ScrolledWindow {
          vexpand: true;
          hscrollbar-policy: never;

          Box categories {
            styles ["index-list"]
            orientation: vertical;
          }
        }

        // The store in use; a menu when there is more than one.
        Box {
          styles ["pass-store"]
          orientation: vertical;
          spacing: 6;

          Box {
            spacing: 6;

            Label {
              styles ["kicker"]
              label:  _("STORE");
              xalign: 0;
              hexpand: true;
            }

            Button add_store {
              styles ["plain"]
              name: "add-store";
              icon-name: "folder-open-symbolic";
              tooltip-text:  _("Another store: a folder with a .gpg-id");
            }
          }

          DropDown store_menu {
            visible: false;
          }

          // The whole path, cut at its start to the column's width.
          Label store_path {
            styles ["pass-path"]
            xalign: 0;
            ellipsize: start;
            max-width-chars: 24;
          }
        }
      }

      // --- entries ---
      Box {
        styles ["pass-entries"]
        orientation: vertical;
        hexpand: false;
        width-request: 280;

        // The category's name, and a new entry beside it.
        Box {
          styles ["pass-col-head"]
          spacing: 6;

          Label entries_title {
            styles ["pass-col-title"]
            hexpand: true;
            xalign: 0;
            ellipsize: end;
          }

          Button new_entry {
            styles ["plain"]
            name: "new-entry";
            icon-name: "list-add-symbolic";
            tooltip-text:  _("New entry");
            valign: center;
          }
        }

        ScrolledWindow {
          vexpand: true;
          hscrollbar-policy: never;

          Box entries {
            styles ["index-list"]
            orientation: vertical;
          }
        }
      }

      // --- details ---
      Stack detail {
        hexpand: true;
        transition-type: crossfade;
        transition-duration: 120;

        StackPage {
          name: "empty";

          child: Label empty_text {
            styles ["sub"]
            wrap: true;
            justify: center;
            margin-start: 32;
            margin-end: 32;
          };
        }

        StackPage {
          name: "entry";

          child: ScrolledWindow {
            hscrollbar-policy: never;

            Box {
              styles ["page"]
              orientation: vertical;

              Box {
                styles ["pass-head"]
                spacing: 6;

                Box {
                  orientation: vertical;
                  hexpand: true;
                  spacing: 2;

                  Label entry_title {
                    styles ["pass-title"]
                    xalign: 0;
                    ellipsize: middle;
                  }

                  Label entry_path {
                    styles ["pass-path"]
                    xalign: 0;
                    ellipsize: start;
                  }
                }

                Button otp_entry {
                  styles ["plain"]
                  name: "otp-entry";
                  icon-name: "pass-qr-code-symbolic";
                  tooltip-text:  _("Add a one-time code");
                  valign: center;
                }

                Button move_entry {
                  styles ["plain"]
                  name: "move-entry";
                  icon-name: "go-jump-symbolic";
                  tooltip-text:  _("Rename or move");
                  valign: center;
                }

                Button edit_entry {
                  styles ["plain"]
                  name: "edit";
                  icon-name: "document-edit-symbolic";
                  tooltip-text:  _("Edit");
                  valign: center;
                }

                Button delete_entry {
                  styles ["plain"]
                  name: "delete";
                  icon-name: "user-trash-symbolic";
                  tooltip-text:  _("Delete");
                  valign: center;
                }
              }

              // While gpg decrypts: a spinner, what is decrypted, and the
              // rows to come, shimmering.
              Box decrypting {
                styles ["pass-decrypting"]
                orientation: vertical;
                visible: false;

                Box {
                  spacing: 14;

                  Spinner spinner {
                    valign: center;
                  }

                  Box {
                    orientation: vertical;
                    spacing: 3;
                    valign: center;

                    Label decrypt_title {
                      styles ["pass-decrypt-title"]
                      xalign: 0;
                      ellipsize: middle;
                    }

                    Label {
                      styles ["sub"]
                      label:  _("gpg may ask for your passphrase, in inua's dialog.");
                      xalign: 0;
                      wrap: true;
                    }
                  }
                }

                Box skeleton {
                  styles ["pass-skeleton"]
                  orientation: vertical;
                }
              }

              // Why it could not be decrypted, and a second try.
              Box decrypt_error {
                styles ["pass-decrypt-error"]
                orientation: vertical;
                spacing: 10;
                visible: false;

                Box {
                  spacing: 12;

                  Image {
                    icon-name: "system-lock-screen-symbolic";
                    pixel-size: 22;
                    valign: start;
                  }

                  Box {
                    orientation: vertical;
                    spacing: 4;
                    hexpand: true;

                    Label {
                      styles ["pass-decrypt-title"]
                      label:  _("It could not be decrypted");
                      xalign: 0;
                    }

                    Label decrypt_error_text {
                      styles ["pass-path"]
                      xalign: 0;
                      wrap: true;
                      wrap-mode: word_char;
                      selectable: true;
                    }
                  }
                }

                Button retry {
                  styles ["outlined"]
                  name: "retry";
                  label:  _("Try again");
                  halign: start;
                }
              }

              // The password, the one-time code, the fields and the notes.
              Box fields {
                styles ["pass-fields"]
                orientation: vertical;
              }

              // An entry of inua-keyring's: the apps trusted with its secret,
              // and its last reads. Filled from Go.
              Box keyring_info {
                orientation: vertical;
                visible: false;
              }
            }
          };
        }

        StackPage {
          name: "edit";

          child: Box {
            styles ["page"]
            orientation: vertical;
            spacing: 10;

            // Its name, and the editor's two ways: a row for each line
            // (the default), or the whole text.
            Box {
              spacing: 12;

              Label edit_title {
                styles ["pass-title"]
                hexpand: true;
                xalign: 0;
                ellipsize: middle;
              }

              Box {
                styles ["segmented", "linked"]
                valign: center;

                ToggleButton edit_rows {
                  label:  _("Rows");
                  tooltip-text:  _("A row for each line");
                  active: true;
                }

                ToggleButton edit_text {
                  label:  _("Text");
                  tooltip-text:  _("The whole entry as text");
                  group: edit_rows;
                }
              }
            }

            Stack edit_mode {
              vexpand: true;
              transition-type: crossfade;
              transition-duration: 120;

              // The lines as they are, in their order, blank ones too:
              // the password's, then the others, each in its row.
              StackPage {
                name: "rows";

                child: Box {
                  orientation: vertical;
                  spacing: 10;

                  Label {
                    styles ["sub"]
                    label:  _("The first line is the password. The lines after it are kept as written, blank ones too: “key: value” lines are fields, an otpauth:// line a one-time code.");
                    xalign: 0;
                    wrap: true;
                  }

                  ScrolledWindow {
                    vexpand: true;
                    hscrollbar-policy: never;

                    Box {
                      orientation: vertical;

                      Box {
                        styles ["pass-row", "pass-edit-row"]
                        spacing: 6;

                        Box {
                          orientation: vertical;
                          spacing: 6;
                          hexpand: true;

                          Label {
                            styles ["kicker"]
                            label:  _("PASSWORD");
                            xalign: 0;
                          }

                          Entry edit_password {
                            styles ["pass-edit-line"]
                            visibility: false;
                            input-purpose: password;

                            accessibility {
                              label:  _("Password");
                            }
                          }
                        }

                        Button edit_reveal {
                          styles ["plain"]
                          name: "edit-reveal";
                          icon-name: "view-reveal-symbolic";
                          tooltip-text:  _("Show");
                          valign: end;
                        }

                        Button edit_generate {
                          styles ["plain"]
                          name: "edit-generate";
                          icon-name: "pass-generate-symbolic";
                          tooltip-text:  _("Generate a password");
                          valign: end;

                          accessibility {
                            label:  _("Generate a password");
                          }
                        }
                      }

                      Label edit_lines_title {
                        styles ["kicker", "pass-edit-lines-title"]
                        label:  _("OTHER LINES");
                        xalign: 0;
                      }

                      // Filled from Go: an entry and a remove button for
                      // each line after the password.
                      Box edit_lines {
                        orientation: vertical;
                      }

                      Button edit_add_line {
                        styles ["outlined", "small", "pass-edit-add"]
                        name: "edit-add-line";
                        halign: start;

                        Box {
                          spacing: 6;

                          Image {
                            icon-name: "list-add-symbolic";
                          }

                          Label {
                            label:  _("Add a line");
                          }
                        }
                      }
                    }
                  }
                };
              }

              StackPage {
                name: "text";

                child: Box {
                  orientation: vertical;
                  spacing: 10;

                  Label {
                    styles ["sub"]
                    label:  _("The first line is the password; lines “key: value” are fields; an otpauth:// line is a one-time code.");
                    xalign: 0;
                    wrap: true;
                  }

                  ScrolledWindow {
                    styles ["pass-editor"]
                    vexpand: true;

                    TextView editor {
                      styles ["pass-text"]
                      monospace: true;
                      wrap-mode: word_char;
                      top-margin: 10;
                      bottom-margin: 10;
                      left-margin: 12;
                      right-margin: 12;
                    }
                  }
                };
              }
            }

            Label edit_error {
              styles ["pass-error"]
              xalign: 0;
              wrap: true;
              visible: false;
            }

            Box {
              spacing: 8;

              // A one-time code from its secret or its QR code: the dialog
              // below puts its otpauth:// line in the text.
              Button edit_otp {
                styles ["outlined"]
                name: "edit-otp";
                hexpand: true;
                halign: start;

                Box {
                  spacing: 6;

                  Image {
                    icon-name: "pass-qr-code-symbolic";
                  }

                  Label {
                    label:  _("One-time code…");
                  }
                }
              }

              Button edit_cancel {
                styles ["outlined"]
                name: "edit-cancel";
                label:  _("Cancel");
              }

              Button edit_save {
                styles ["suggested-action"]
                name: "edit-save";
                label:  _("Save");
              }
            }
          };
        }
      }
    }

    // The search's results, from every category, over the columns; Go
    // places it under the search.
    [overlay]
    Box results_card {
      styles ["pass-results"]
      orientation: vertical;
      halign: start;
      valign: start;
      width-request: 460;
      visible: false;

      ScrolledWindow results_scroll {
        hscrollbar-policy: never;
        propagate-natural-height: true;
        max-content-height: 440;

        Box results {
          styles ["index-list"]
          orientation: vertical;
        }
      }

      Label results_note {
        styles ["sub", "pass-results-note"]
        xalign: 0;
        wrap: true;
      }
    }
  }
}

// New entry, rename or move, and delete: the path in one field, and what
// it would do, previewed as it is typed. Modal over the window.
Window pass_dialog {
  styles ["app", "settings", "pass", "pass-dialog"]
  modal: true;
  resizable: false;
  default-width: 480;
  hide-on-close: true;

  Box {
    styles ["page"]
    orientation: vertical;
    spacing: 12;

    Label dialog_title {
      styles ["pass-title"]
      xalign: 0;
      wrap: true;
    }

    Label dialog_text {
      styles ["sub"]
      xalign: 0;
      wrap: true;
    }

    Entry dialog_path {
      styles ["pass-path-entry"]
      placeholder-text:  _("category/name");
    }

    // Where it ends up: its category and name, and each entry it moves.
    Box dialog_preview {
      styles ["pass-preview"]
      orientation: vertical;
      spacing: 6;
    }

    Label dialog_error {
      styles ["pass-error"]
      xalign: 0;
      wrap: true;
      visible: false;
    }

    Box {
      spacing: 8;
      halign: end;
      margin-top: 4;

      Button dialog_cancel {
        styles ["outlined"]
        name: "dialog-cancel";
        label:  _("Cancel");
      }

      Button dialog_ok {
        styles ["suggested-action"]
        name: "dialog-ok";
      }
    }
  }
}

// A one-time code: its secret or otpauth:// link typed or pasted, or
// read from a QR code on the screen or in an image; the code it makes,
// shown as it would be now. Modal over the window.
Window otp_dialog {
  styles ["app", "settings", "pass", "pass-dialog"]
  modal: true;
  resizable: false;
  default-width: 520;
  hide-on-close: true;

  Box {
    styles ["page"]
    orientation: vertical;
    spacing: 12;

    Label otp_title {
      styles ["pass-title"]
      label:  _("Add a one-time code");
      xalign: 0;
      wrap: true;
    }

    Label {
      styles ["sub"]
      label:  _("Paste the secret the site shows, or its otpauth:// link. Or read its QR code: from the screen, an area of it, or an image.");
      xalign: 0;
      wrap: true;
    }

    Entry otp_input {
      styles ["pass-path-entry"]
      placeholder-text:  _("JBSW Y3DP EHPK 3PXP, or otpauth://…");
    }

    Box {
      spacing: 8;

      Button otp_scan {
        styles ["outlined"]
        name: "otp-scan";
        tooltip-text:  _("The Pass windows step aside while the screen is read");

        Box {
          spacing: 6;

          Image {
            icon-name: "pass-scan-symbolic";
          }

          Label {
            label:  _("Scan the screen");
          }
        }
      }

      Button otp_area {
        styles ["outlined"]
        name: "otp-area";
        tooltip-text:  _("Drag out the area with the QR code");

        Box {
          spacing: 6;

          Image {
            icon-name: "applets-screenshooter-symbolic";
          }

          Label {
            label:  _("Select an area");
          }
        }
      }

      Button otp_image {
        styles ["outlined"]
        name: "otp-image";

        Box {
          spacing: 6;

          Image {
            icon-name: "image-x-generic-symbolic";
          }

          Label {
            label:  _("From an image…");
          }
        }
      }
    }

    // Who the code is for, as other authenticator apps name it.
    Box {
      spacing: 8;
      homogeneous: true;

      Entry otp_issuer {
        placeholder-text:  _("Issuer, e.g. GitHub");
      }

      Entry otp_account {
        placeholder-text:  _("Account, e.g. you@example.org");
      }
    }

    // The code it makes now, and the seconds it stays.
    Box otp_preview {
      styles ["pass-row"]
      spacing: 12;
      visible: false;

      Box {
        orientation: vertical;
        spacing: 3;
        hexpand: true;

        Label {
          styles ["kicker"]
          label:  _("ONE-TIME CODE");
          xalign: 0;
        }

        Box {
          spacing: 12;

          Label otp_code {
            styles ["pass-otp"]
            xalign: 0;
          }

          Label otp_left {
            styles ["sub"]
            valign: center;
          }
        }
      }
    }

    Label otp_status {
      styles ["sub"]
      xalign: 0;
      wrap: true;
      visible: false;
    }

    Label otp_error {
      styles ["pass-error"]
      xalign: 0;
      wrap: true;
      visible: false;
    }

    Box {
      spacing: 8;
      halign: end;
      margin-top: 4;

      Button otp_cancel {
        styles ["outlined"]
        name: "otp-cancel";
        label:  _("Cancel");
      }

      Button otp_ok {
        styles ["suggested-action"]
        name: "otp-ok";
        label:  _("Add");
        sensitive: false;
      }
    }
  }
}

// Security keys (docs/security-key.md): the store's keys, the
// security keys that unlock each, and adding one.
Window seckey_dialog {
  styles ["app", "settings", "pass", "pass-dialog"]
  modal: true;
  resizable: false;
  default-width: 520;
  hide-on-close: true;

  Box {
    styles ["page"]
    orientation: vertical;
    spacing: 12;

    Label {
      styles ["pass-title"]
      label:  _("Security keys");
      xalign: 0;
      wrap: true;
    }

    Label {
      styles ["sub"]
      label:  _("Unlock the store's key with a FIDO2 security key, such as a YubiKey: its PIN and a touch in place of the passphrase. The passphrase keeps working.");
      xalign: 0;
      wrap: true;
    }

    // A section for each of the store's keys, filled in when it opens.
    Box seckey_keys {
      orientation: vertical;
    }

    // Adding a security key to the key chosen.
    Box seckey_form {
      orientation: vertical;
      spacing: 8;
      visible: false;

      Label seckey_form_title {
        styles ["sub"]
        xalign: 0;
        wrap: true;
      }

      PasswordEntry seckey_passphrase {
        placeholder-text:  _("The key's passphrase");
        show-peek-icon: true;
      }

      PasswordEntry seckey_pin {
        placeholder-text:  _("The security key's PIN");
      }
    }

    Label seckey_status {
      styles ["sub"]
      xalign: 0;
      wrap: true;
      visible: false;
    }

    Label seckey_error {
      styles ["pass-error"]
      xalign: 0;
      wrap: true;
      visible: false;
    }

    Box {
      spacing: 8;
      halign: end;
      margin-top: 4;

      Button seckey_close {
        styles ["outlined"]
        name: "seckey-close";
        label:  _("Close");
      }

      Button seckey_add {
        styles ["suggested-action"]
        name: "seckey-add";
        label:  _("Add");
        visible: false;
        sensitive: false;
      }
    }
  }
}
