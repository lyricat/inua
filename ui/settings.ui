                      <object class="GtkScrolledWindow" id="scroll_mouse">
                        <property name="hscrollbar-policy">2</property>
                        <child>
                          <object class="GtkBox">
                            <style>
                              <class name="page"/>
                            </style>
                            <property name="orientation">1</property>
                            <child>
                              <object class="GtkLabel" id="tp_warn">
                                <style>
                                  <class name="warn"/>
                                </style>
                                <property name="visible">false</property>
                                <property name="xalign">0</property>
                                <property name="wrap">true</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <style>
                                  <class name="section"/>
                                </style>
                                <property name="orientation">1</property>
                                <child>
                                  <object class="GtkBox">
                                    <style>
                                      <class name="section-head"/>
                                    </style>
                                    <property name="spacing">10</property>
                                    <child>
                                      <object class="GtkBox">
                                        <style>
                                          <class name="mark"/>
                                        </style>
                                        <property name="valign">3</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <style>
                                          <class name="section-label"/>
                                        </style>
                                        <property name="use-markup">true</property>
                                        <property name="label" translatable="yes">&lt;span alpha='55%'&gt;[&lt;/span&gt;POINTER&lt;span alpha='55%'&gt;]&lt;/span&gt;</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <style>
                                          <class name="section-meta"/>
                                        </style>
                                        <property name="label" translatable="yes">Every touchpad</property>
                                        <property name="hexpand">true</property>
                                        <property name="xalign">0</property>
                                        <property name="ellipsize">3</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <style>
                                      <class name="section-body"/>
                                    </style>
                                    <property name="orientation">1</property>
                                    <child>
                                      <object class="GtkBox">
                                        <style>
                                          <class name="row"/>
                                        </style>
                                        <property name="spacing">16</property>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">1</property>
                                            <property name="valign">3</property>
                                            <property name="width-request">150</property>
                                            <child>
                                              <object class="GtkLabel">
                                                <style>
                                                  <class name="title"/>
                                                </style>
                                                <property name="label" translatable="yes">Pointer speed</property>
                                                <property name="xalign">0</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel" id="tp_value">
                                                <style>
                                                  <class name="readout"/>
                                                </style>
                                                <property name="xalign">0</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkScale" id="tp_speed">
                                            <property name="name">tp_speed</property>
                                            <property name="hexpand">true</property>
                                            <property name="valign">3</property>
                                            <property name="draw-value">false</property>
                                            <property name="adjustment">
                                              <object class="GtkAdjustment">
                                                <property name="lower">-1</property>
                                                <property name="upper">1</property>
                                                <property name="step-increment">0.05</property>
                                                <property name="page-increment">0.25</property>
                                              </object>
                                            </property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkSeparator"></object>
                                    </child>
                                    <child>
                                      <object class="GtkBox">
                                        <style>
                                          <class name="row"/>
                                        </style>
                                        <property name="spacing">16</property>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">1</property>
                                            <property name="hexpand">true</property>
                                            <property name="valign">3</property>
                                            <child>
                                              <object class="GtkLabel">
                                                <style>
                                                  <class name="title"/>
                                                </style>
                                                <property name="label" translatable="yes">Acceleration</property>
                                                <property name="xalign">0</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel">
                                                <style>
                                                  <class name="sub"/>
                                                </style>
                                                <property name="label" translatable="yes">Faster swipes move the pointer further</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkSwitch" id="tp_accel">
                                            <property name="name">tp_accel</property>
                                            <property name="valign">3</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <style>
                                  <class name="section"/>
                                </style>
                                <property name="orientation">1</property>
                                <child>
                                  <object class="GtkBox">
                                    <style>
                                      <class name="section-head"/>
                                    </style>
                                    <property name="spacing">10</property>
                                    <child>
                                      <object class="GtkBox">
                                        <style>
                                          <class name="mark"/>
                                        </style>
                                        <property name="valign">3</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <style>
                                          <class name="section-label"/>
                                        </style>
                                        <property name="use-markup">true</property>
                                        <property name="label" translatable="yes">&lt;span alpha='55%'&gt;[&lt;/span&gt;SOURCE&lt;span alpha='55%'&gt;]&lt;/span&gt;</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <style>
                                          <class name="section-meta"/>
                                        </style>
                                        <property name="label" translatable="yes">inua writes these to Hyprland's inua.conf</property>
                                        <property name="hexpand">true</property>
                                        <property name="xalign">0</property>
                                        <property name="ellipsize">3</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <style>
                                      <class name="section-body"/>
                                    </style>
                                    <property name="orientation">1</property>
                                    <child>
                                      <object class="GtkBox">
                                        <style>
                                          <class name="row"/>
                                        </style>
                                        <property name="spacing">16</property>
                                        <child>
                                          <object class="GtkLabel" id="tp_state">
                                            <style>
                                              <class name="title"/>
                                            </style>
                                            <property name="hexpand">true</property>
                                            <property name="xalign">0</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton" id="tp_reset">
                                            <style>
                                              <class name="outlined"/>
                                            </style>
                                            <property name="name">tp_reset</property>
                                            <property name="valign">3</property>
                                            <property name="label" translatable="yes">Use hyprland.conf</property>
                                            <property name="tooltip-text" translatable="yes">Stop setting the touchpad in inua</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                    <child type="overlay">
                      <object class="GtkBox" id="sticky_mouse">
                        <style>
                          <class name="section-head"/>
                          <class name="sticky"/>
                        </style>
                        <property name="spacing">10</property>
                        <property name="valign">1</property>
                        <property name="visible">false</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">voice</property>
                <property name="title" translatable="yes">Voice</property>
                <property name="child">
                  <object class="GtkOverlay">
                    <property name="child">
                      <object class="GtkScrolledWindow" id="scroll_voice">
                        <property name="hscrollbar-policy">2</property>
                        <child>
                          <object class="GtkBox" id="voice_page">
                            <style>
                              <class name="page"/>
                            </style>
                            <property name="orientation">1</property>
                          </object>
                        </child>
                      </object>
                    </property>
                    <child type="overlay">
                      <object class="GtkBox" id="sticky_voice">
                        <style>
                          <class name="section-head"/>
                          <class name="sticky"/>
                        </style>
                        <property name="spacing">10</property>
                        <property name="valign">1</property>
                        <property name="visible">false</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">power</property>
                <property name="title" translatable="yes">Power</property>
                <property name="child">
                  <object class="GtkOverlay">
                    <property name="child">
                      <object class="GtkScrolledWindow" id="scroll_power">
                        <property name="hscrollbar-policy">2</property>
                        <child>
                          <object class="GtkBox" id="power_page">
                            <style>
                              <class name="page"/>
                            </style>
                            <property name="orientation">1</property>
                          </object>
                        </child>
                      </object>
                    </property>
                    <child type="overlay">
                      <object class="GtkBox" id="sticky_power">
                        <style>
                          <class name="section-head"/>
                          <class name="sticky"/>
                        </style>
                        <property name="spacing">10</property>
                        <property name="valign">1</property>
                        <property name="visible">false</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">about</property>
                <property name="title" translatable="yes">About</property>
                <property name="child">
                  <object class="GtkOverlay">
                    <property name="child">
                      <object class="GtkScrolledWindow" id="scroll_about">
                        <property name="hscrollbar-policy">2</property>
                        <child>
                          <object class="GtkBox">
                            <style>
                              <class name="page"/>
                            </style>
                            <property name="orientation">1</property>
                            <child>
                              <object class="GtkBox">
                                <style>
                                  <class name="section"/>
                                </style>
                                <property name="orientation">1</property>
                                <child>
                                  <object class="GtkBox">
                                    <style>
                                      <class name="section-head"/>
                                    </style>
                                    <property name="spacing">10</property>
                                    <child>
                                      <object class="GtkBox">
                                        <style>
                                          <class name="mark"/>
                                        </style>
                                        <property name="valign">3</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <style>
                                          <class name="section-label"/>
                                        </style>
                                        <property name="use-markup">true</property>
                                        <property name="label" translatable="yes">&lt;span alpha='55%'&gt;[&lt;/span&gt;SYSTEM&lt;span alpha='55%'&gt;]&lt;/span&gt;</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <style>
                                          <class name="section-meta"/>
                                        </style>
                                        <property name="label" translatable="yes">This computer, as a card to share</property>
                                        <property name="hexpand">true</property>
                                        <property name="xalign">0</property>
                                        <property name="ellipsize">3</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkButton" id="about_card_image">
                                        <style>
                                          <class name="outlined"/>
                                        </style>
                                        <property name="name">about_card_image</property>
                                        <property name="label" translatable="yes">Copy image</property>
                                        <property name="valign">3</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkButton" id="about_fetch_copy">
                                        <style>
                                          <class name="outlined"/>
                                        </style>
                                        <property name="name">about_fetch_copy</property>
                                        <property name="label" translatable="yes">Copy text</property>
                                        <property name="valign">3</property>
                                        <property name="tooltip-text" translatable="yes">As Markdown</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkButton" id="about_card_save">
                                        <style>
                                          <class name="outlined"/>
                                        </style>
                                        <property name="name">about_card_save</property>
                                        <property name="label" translatable="yes">Save…</property>
                                        <property name="valign">3</property>
                                        <property name="tooltip-text" translatable="yes">As a PNG image</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox" id="about_fetch">
                                    <style>
                                      <class name="section-body"/>
                                      <class name="fetch"/>
                                    </style>
                                    <property name="orientation">1</property>
                                    <property name="spacing">8</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <style>
                                  <class name="section"/>
                                </style>
                                <property name="orientation">1</property>
                                <child>
                                  <object class="GtkBox">
                                    <style>
                                      <class name="section-head"/>
                                    </style>
                                    <property name="spacing">10</property>
                                    <child>
                                      <object class="GtkBox">
                                        <style>
                                          <class name="mark"/>
                                        </style>
                                        <property name="valign">3</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <style>
                                          <class name="section-label"/>
                                        </style>
                                        <property name="use-markup">true</property>
                                        <property name="label" translatable="yes">&lt;span alpha='55%'&gt;[&lt;/span&gt;INUA&lt;span alpha='55%'&gt;]&lt;/span&gt;</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <style>
                                          <class name="section-meta"/>
                                        </style>
                                        <property name="label" translatable="yes">The version, and new releases</property>
                                        <property name="hexpand">true</property>
                                        <property name="xalign">0</property>
                                        <property name="ellipsize">3</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <style>
                                      <class name="section-body"/>
                                    </style>
                                    <property name="orientation">1</property>
                                    <child>
                                      <object class="GtkBox">
                                        <style>
                                          <class name="row"/>
                                        </style>
                                        <property name="spacing">16</property>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">1</property>
                                            <property name="hexpand">true</property>
                                            <property name="valign">3</property>
                                            <child>
                                              <object class="GtkLabel">
                                                <style>
                                                  <class name="title"/>
                                                </style>
                                                <property name="label" translatable="yes">Version</property>
                                                <property name="xalign">0</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel" id="about_version">
                                                <style>
                                                  <class name="sub"/>
                                                </style>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkSeparator"></object>
                                    </child>
                                    <child>
                                      <object class="GtkBox">
                                        <style>
                                          <class name="row"/>
                                        </style>
                                        <property name="spacing">16</property>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">1</property>
                                            <property name="hexpand">true</property>
                                            <property name="valign">3</property>
                                            <child>
                                              <object class="GtkLabel">
                                                <style>
                                                  <class name="title"/>
                                                </style>
                                                <property name="label" translatable="yes">Updates</property>
                                                <property name="xalign">0</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel" id="about_state">
                                                <style>
                                                  <class name="sub"/>
                                                </style>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="spacing">8</property>
                                            <property name="homogeneous">true</property>
                                            <property name="valign">3</property>
                                            <child>
                                              <object class="GtkButton" id="about_upgrade">
                                                <style>
                                                  <class name="primary"/>
                                                </style>
                                                <property name="name">about_upgrade</property>
                                                <property name="visible">false</property>
                                                <property name="label" translatable="yes">Upgrade</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkButton" id="about_check">
                                                <style>
                                                  <class name="outlined"/>
                                                </style>
                                                <property name="name">about_check</property>
                                                <property name="label" translatable="yes">Check for updates</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkSeparator"></object>
                                    </child>
                                    <child>
                                      <object class="GtkBox">
                                        <style>
                                          <class name="row"/>
                                        </style>
                                        <property name="spacing">16</property>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">1</property>
                                            <property name="hexpand">true</property>
                                            <property name="valign">3</property>
                                            <child>
                                              <object class="GtkLabel">
                                                <style>
                                                  <class name="title"/>
                                                </style>
                                                <property name="label" translatable="yes">Check every day</property>
                                                <property name="xalign">0</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel">
                                                <style>
                                                  <class name="sub"/>
                                                </style>
                                                <property name="label" translatable="yes">A notification says when a new release is out, with a button to upgrade</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkSwitch" id="about_daily">
                                            <property name="name">about_daily</property>
                                            <property name="valign">3</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <style>
                                  <class name="section"/>
                                </style>
                                <property name="orientation">1</property>
                                <child>
                                  <object class="GtkBox">
                                    <style>
                                      <class name="section-head"/>
                                    </style>
                                    <property name="spacing">10</property>
                                    <child>
                                      <object class="GtkBox">
                                        <style>
                                          <class name="mark"/>
                                        </style>
                                        <property name="valign">3</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <style>
                                          <class name="section-label"/>
                                        </style>
                                        <property name="use-markup">true</property>
                                        <property name="label" translatable="yes">&lt;span alpha='55%'&gt;[&lt;/span&gt;CHANGELOG&lt;span alpha='55%'&gt;]&lt;/span&gt;</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <style>
                                          <class name="section-meta"/>
                                        </style>
                                        <property name="label" translatable="yes">What the latest release changed</property>
                                        <property name="hexpand">true</property>
                                        <property name="xalign">0</property>
                                        <property name="ellipsize">3</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox" id="about_changelog">
                                    <style>
                                      <class name="section-body"/>
                                    </style>
                                    <property name="orientation">1</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                    <child type="overlay">
                      <object class="GtkBox" id="sticky_about">
                        <style>
                          <class name="section-head"/>
                          <class name="sticky"/>
                        </style>
                        <property name="spacing">10</property>
                        <property name="valign">1</property>
                        <property name="visible">false</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
