                                            <property name="label" translatable="yes">Email</property>
                                            <property name="hexpand">true</property>
                                            <property name="xalign">0</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkEntry" id="new_email">
                                            <property name="width-chars">30</property>
                                            <property name="input-purpose">6</property>
                                            <property name="valign">3</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox">
                                        <style>
                                          <class name="row"/>
                                        </style>
                                        <property name="spacing">12</property>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">1</property>
                                            <property name="hexpand">true</property>
                                            <property name="valign">3</property>
                                            <child>
                                              <object class="GtkLabel">
                                                <style>
                                                  <class name="title"/>
                                                </style>
                                                <property name="label" translatable="yes">Expires</property>
                                                <property name="xalign">0</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel">
                                                <style>
                                                  <class name="sub"/>
                                                </style>
                                                <property name="label" translatable="yes">You can extend it before then; an expired key still decrypts</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">true</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkDropDown" id="new_expire">
                                            <property name="valign">3</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <style>
                                          <class name="sub"/>
                                        </style>
                                        <property name="label" translatable="yes">gpg asks for a passphrase to protect the new key. Remember it: without it the key cannot be used.</property>
                                        <property name="xalign">0</property>
                                        <property name="wrap">true</property>
                                        <property name="margin-top">14</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="spacing">8</property>
                                        <property name="margin-top">18</property>
                                        <child>
                                          <object class="GtkLabel">
                                            <style>
                                              <class name="sub"/>
                                            </style>
                                            <property name="label" translatable="yes">Or in a terminal:</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <style>
                                              <class name="gpg-mono-sub"/>
                                            </style>
                                            <property name="label">gpg --full-generate-key</property>
                                            <property name="selectable">true</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <style>
                                  <class name="gpg-bar"/>
                                </style>
                                <property name="spacing">8</property>
                                <child>
                                  <object class="GtkButton" id="b_keys_back2">
                                    <style>
                                      <class name="outlined"/>
                                    </style>
                                    <property name="name">keys-back</property>
                                    <property name="label" translatable="yes">Cancel</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="new_status">
                                    <style>
                                      <class name="sub"/>
                                    </style>
                                    <property name="hexpand">true</property>
                                    <property name="xalign">1</property>
                                    <property name="wrap">true</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="new_do">
                                    <style>
                                      <class name="suggested-action"/>
                                    </style>
                                    <property name="name">new-do</property>
                                    <property name="label" translatable="yes">Create</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkWindow" id="gpg_dialog">
    <style>
      <class name="app"/>
      <class name="settings"/>
      <class name="gpg"/>
      <class name="gpg-dialog"/>
    </style>
    <property name="modal">true</property>
    <property name="resizable">false</property>
    <property name="default-width">460</property>
    <property name="hide-on-close">true</property>
    <child>
      <object class="GtkBox">
        <style>
          <class name="page"/>
        </style>
        <property name="orientation">1</property>
        <property name="spacing">12</property>
        <child>
          <object class="GtkLabel" id="dialog_title">
            <style>
              <class name="gpg-dialog-title"/>
            </style>
            <property name="xalign">0</property>
            <property name="wrap">true</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="dialog_key">
            <style>
              <class name="gpg-mono-sub"/>
            </style>
            <property name="xalign">0</property>
            <property name="wrap">true</property>
            <property name="wrap-mode">2</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="dialog_text">
            <style>
              <class name="sub"/>
            </style>
            <property name="xalign">0</property>
            <property name="wrap">true</property>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="spacing">8</property>
            <property name="halign">2</property>
            <property name="margin-top">4</property>
            <child>
              <object class="GtkButton" id="dialog_cancel">
                <style>
                  <class name="outlined"/>
                </style>
                <property name="name">dialog-cancel</property>
                <property name="label" translatable="yes">Cancel</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="dialog_ok">
                <style>
                  <class name="destructive-action"/>
                </style>
                <property name="name">dialog-ok</property>
                <property name="label" translatable="yes">Delete</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>