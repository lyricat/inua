// Settings: a normal window (not a layer surface) that edits config.toml,
// in two columns: an index of the sections (its row names the page shown),
// and the chosen one's page.
// Pages hold sections (a head with a mark, a [LABEL] and a description on a
// hairline) of rows: text with a control at the end, or a labelled field.
// Changes apply to the running shell at once and are saved a moment later.
// Controls carry a `name` that Go uses to tell them apart; theme swatches
// are added to `themes` from Go.
using Gtk 4.0;

ApplicationWindow settings {
  styles ["settings"]
  title:  _("inua Settings");
  default-width: 860;
  default-height: 620;

  Box {
    // --- index ---
    Box {
      styles ["index"]
      orientation: vertical;
      width-request: 220;

      Label {
        styles ["index-title"]
        label:  _("Settings");
        xalign: 0;
      }

      // Finds a page or a setting by what it says (settings_search.go);
      // typing anywhere in the window types here.
      SearchEntry settings_search {
        placeholder-text:  _("Search settings");
      }

      // The pages, each with its icon (settings_index.go); while a search
      // is typed, what it found instead.
      ScrolledWindow {
        vexpand: true;
        hscrollbar-policy: never;

        Box {
          orientation: vertical;

          ListBox index {
            selection-mode: browse;
          }

          ListBox settings_results {
            styles ["results"]
            selection-mode: browse;
            visible: false;
          }

          Label settings_no_results {
            styles ["index-note"]
            label:  _("Nothing matches.");
            xalign: 0;
            wrap: true;
            visible: false;
          }
        }
      }

      // Why saving failed; hidden otherwise.
      Label status {
        styles ["status"]
        visible: false;
        xalign: 0;
        wrap: true;
      }

    }

    Stack pages {
      hexpand: true;
      transition-type: crossfade;
      transition-duration: 120;

      StackPage {
        name: "appearance";
        title:  _("Appearance");

        child: Overlay {
          child: ScrolledWindow scroll_appearance {
            hscrollbar-policy: never;

            Box {
              styles ["page"]
              orientation: vertical;

              // [THEME]
              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    use-markup: true;
                    label:  _("<span alpha='55%'>[</span>THEME<span alpha='55%'>]</span>");
                  }

                  Label {
                    styles ["section-meta"]
                    label:  _("The bar, launcher, control center and this window");
                    hexpand: true;
                    xalign: 0;
                    ellipsize: end;
                  }
                }

                Box {
                  styles ["section-body"]
                  orientation: vertical;

                  FlowBox themes {
                    selection-mode: none;
                    homogeneous: true;
                    min-children-per-line: 3;
                    max-children-per-line: 4;
                    row-spacing: 8;
                    column-spacing: 8;
                  }

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;

                      Label {
                        styles ["title"]
                        label:  _("Your themes");
                        xalign: 0;
                      }
                      Label {
                        styles ["sub"]
                        label:  _("A CSS file of @define-color lines, kept in themes beside config.toml");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button theme_add {
                      styles ["outlined"]
                      name: "theme_add";
                      label:  _("Add…");
                      valign: center;
                    }

                    Button theme_trash {
                      styles ["outlined", "danger"]
                      name: "theme_trash";
                      label:  _("Move to Trash");
                      tooltip-text:  _("The theme in use, if it is one of yours");
                      valign: center;
                    }

                    Button theme_folder {
                      styles ["outlined"]
                      name: "theme_folder";
                      label:  _("Open Folder");
                      valign: center;
                    }
                  }
                }
              }

              // [TEXT]
              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    use-markup: true;
                    label:  _("<span alpha='55%'>[</span>TEXT<span alpha='55%'>]</span>");
                  }

                  Label {
                    styles ["section-meta"]
                    label:  _("The shell and inua's apps");
                    hexpand: true;
                    xalign: 0;
                    ellipsize: end;
                  }
                }

                Box {
                  styles ["section-body"]
                  orientation: vertical;

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;

                      Label {
                        styles ["title"]
                        label:  _("Text size");
                        xalign: 0;
                      }
                      Label {
                        styles ["sub"]
                        label:  _("Icons and spacing keep their size");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    DropDown text_scale {
                      name: "text_scale";
                      valign: center;
                    }
                  }

                  Separator {}

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      width-request: 260;
                      valign: center;

                      Label {
                        styles ["title"]
                        label:  _("Transparency");
                        xalign: 0;
                      }
                      Label transparency_val {
                        styles ["readout"]
                        xalign: 0;
                      }
                    }

                    Scale transparency {
                      name: "transparency";
                      hexpand: true;
                      valign: center;
                      draw-value: false;

                      adjustment: Adjustment {
                        lower: 0;
                        upper: 80;
                        step-increment: 1;
                        page-increment: 5;
                      };
                    }
                  }

                  Separator {}

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      width-request: 260;
                      valign: center;

                      Label {
                        styles ["title"]
                        label:  _("Corner radius");
                        xalign: 0;
                      }
                      Label radius_val {
                        styles ["readout"]
                        xalign: 0;
                      }
                    }

                    Scale radius {
                      name: "radius";
                      hexpand: true;
                      valign: center;
                      draw-value: false;

                      adjustment: Adjustment {
                        lower: 0;
                        upper: 20;
                        step-increment: 1;
                        page-increment: 4;
                      };
                    }
                  }
                }
              }

              // [ICONS]
              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    use-markup: true;
                    label:  _("<span alpha='55%'>[</span>ICONS<span alpha='55%'>]</span>");
                  }

                  Label {
                    styles ["section-meta"]
                    label:  _("The shell's own, and those of apps and files");
                    hexpand: true;
                    xalign: 0;
                    ellipsize: end;
                  }
                }

                Box {
                  styles ["section-body"]
                  orientation: vertical;

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;

                      Label {
                        styles ["title"]
                        label:  _("Icon set");
                        xalign: 0;
                      }
                      Label {
                        styles ["sub"]
                        label:  _("Built in, the system's, an installed theme or one of yours");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    DropDown icons {
                      name: "icons";
                      valign: center;

                      model: StringList {
                        strings [
                          _("Phosphor"),
                          _("System theme"),
                        ]
                      };
                    }
                  }

                  // Go adds the installed icon themes.
                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;

                      Label {
                        styles ["title"]
                        label:  _("App icons");
                        xalign: 0;
                      }
                      Label {
                        styles ["sub"]
                        label:  _("The dock, launcher, notifications and files");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    DropDown app_icons {
                      name: "app_icons";
                      valign: center;

                      model: StringList {
                        strings [
                          _("System theme"),
                        ]
                      };
                    }
                  }

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;

                      Label {
                        styles ["title"]
                        label:  _("Your icon sets");
                        xalign: 0;
                      }
                      Label {
                        styles ["sub"]
                        label:  _("A folder of SVG icons named like inua's, kept in icons beside config.toml");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button iconset_add {
                      styles ["outlined"]
                      name: "iconset_add";
                      label:  _("Add…");
                      valign: center;
                    }

                    Button iconset_trash {
                      styles ["outlined", "danger"]
                      name: "iconset_trash";
                      label:  _("Move to Trash");
                      tooltip-text:  _("The icon set in use, if it is one of yours");
                      valign: center;
                    }

                    Button iconset_folder {
                      styles ["outlined"]
                      name: "iconset_folder";
                      label:  _("Open Folder");
                      valign: center;
                    }
                  }
                }
              }


              // [LANGUAGE]
              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    use-markup: true;
                    label:  _("<span alpha='55%'>[</span>LANGUAGE<span alpha='55%'>]</span>");
                  }

                  Label {
                    styles ["section-meta"]
                    label:  _("The shell, settings and light apps");
                    hexpand: true;
                    xalign: 0;
                    ellipsize: end;
                  }
                }

                Box {
                  styles ["section-body"]
                  orientation: vertical;

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;

                      Label {
                        styles ["title"]
                        label:  _("Language");
                        xalign: 0;
                      }
                      Label {
                        styles ["sub"]
                        label:  _("Programs use it when they start");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    // In the order of config.Languages; each language
                    // named in itself.
                    DropDown language {
                      name: "language";
                      valign: center;

                      model: StringList {
                        strings [
                          _("Same as the system"),
                          "English",
                          "简体中文",
                          "繁體中文",
                          "日本語",
                          "한국어",
                          "Español",
                          "Français",
                        ]
                      };
                    }
                  }

                  // Shown once the language differs from the one the shell
                  // started in.
                  Box lang_restart_row {
                    styles ["row"]
                    spacing: 16;
                    visible: false;

                    Label {
                      styles ["sub"]
                      label:  _("Restart the shell to use it now; open apps change when you open them again.");
                      hexpand: true;
                      xalign: 0;
                      wrap: true;
                    }

                    Button lang_restart {
                      styles ["outlined"]
                      name: "lang_restart";
                      label:  _("Restart the shell");
                      valign: center;
                    }
                  }
                }
              }


              // [PICTURE]
              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    use-markup: true;
                    label:  _("<span alpha='55%'>[</span>PICTURE<span alpha='55%'>]</span>");
                  }

                  Label {
                    styles ["section-meta"]
                    label:  _("Behind your windows, on every monitor");
                    hexpand: true;
                    xalign: 0;
                    ellipsize: end;
                  }
                }

                Box {
                  styles ["section-body"]
                  orientation: vertical;

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;

                      Label {
                        styles ["title"]
                        label:  _("inua draws the wallpaper");
                        xalign: 0;
                      }
                      Label {
                        styles ["sub"]
                        label:  _("A new picture each day, drawn for your theme: a sunset, the cosmos, a cat watching the moon …");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button bg_another {
                      styles ["plain"]
                      name: "bg_another";
                      valign: center;
                      icon-name: "media-playlist-shuffle-symbolic";
                      tooltip-text:  _("Draw another");
                    }

                    Switch bg_generate {
                      name: "bg_generate";
                      valign: center;
                    }
                  }

                  // The image and how it shows, hidden while inua draws.
                  Box bg_own {
                    orientation: vertical;

                    Separator {}

                    Box {
                      styles ["field"]
                      orientation: vertical;
                      spacing: 6;

                      Label {
                        styles ["label"]
                        label:  _("Image");
                        xalign: 0;
                      }

                      Box {
                        spacing: 8;

                        Entry bg_image {
                          name: "bg_image";
                          hexpand: true;
                          placeholder-text:  _("none: a fine texture");
                        }

                        Button bg_choose {
                          styles ["outlined"]
                          name: "bg_choose";
                          label:  _("Choose…");
                        }

                        Button bg_clear {
                          styles ["plain"]
                          name: "bg_clear";
                          icon-name: "edit-clear-symbolic";
                          tooltip-text:  _("No image");
                        }
                      }
                    }

                    Separator {}

                    Box {
                      styles ["row"]
                      spacing: 16;

                      Box {
                        orientation: vertical;
                        hexpand: true;
                        valign: center;

                        Label {
                          styles ["title"]
                          label:  _("Fit");
                          xalign: 0;
                        }
                        Label {
                          styles ["sub"]
                          label:  _("How the picture fills each monitor");
                          xalign: 0;
                          wrap: true;
                        }
                      }

                      DropDown bg_fit {
                        name: "bg_fit";
                        valign: center;

                        model: StringList {
                          strings [
                            _("Cover: fill, cropping"),
                            _("Contain: show it all"),
                            _("Tile: repeat"),
                            _("Center: actual size"),
                          ]
                        };
                      }
                    }

                    Separator {}

                    Box {
                      styles ["field"]
                      orientation: vertical;
                      spacing: 6;

                      Label {
                        styles ["label"]
                        label:  _("Colour");
                        xalign: 0;
                      }

                      Entry bg_color {
                        name: "bg_color";
                        styles ["mono-entry"]
                        halign: start;
                        width-chars: 10;
                        max-length: 7;
                        placeholder-text:  _("theme");
                      }

                      Label {
                        styles ["sub"]
                        label:  _("#rrggbb, shown around the image. Empty: the theme's ground");
                        xalign: 0;
                        wrap: true;
                      }
                    }
                  }
                }
              }
  }
          };

          // The head of the section scrolled under the top edge.
          [overlay]
          Box sticky_appearance {
            styles ["section-head", "sticky"]
            spacing: 10;
            valign: start;
            visible: false;
          }
        };
      }

      StackPage {
        name: "bar";
        title:  _("Bar & Dock");

        child: Overlay {
          child: ScrolledWindow scroll_bar {
            hscrollbar-policy: never;

            Box {
              styles ["page"]
              orientation: vertical;

              // [BAR]
              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    use-markup: true;
                    label:  _("<span alpha='55%'>[</span>BAR<span alpha='55%'>]</span>");
                  }

                  Label {
                    styles ["section-meta"]
                    label:  _("The bar along the top of each monitor");
                    hexpand: true;
                    xalign: 0;
                    ellipsize: end;
                  }
                }

                Box {
                  styles ["section-body"]
                  orientation: vertical;

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;

                      Label {
                        styles ["title"]
                        label:  _("Show the bar");
                        xalign: 0;
                      }
                      Label {
                        styles ["sub"]
                        label:  _("Off: Super+Space, Super+A and Super+N still open the launcher, control center and notifications");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Switch bar_enable {
                      name: "bar_enable";
                      valign: center;
                    }
                  }

                  Separator {}

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;

                      Label {
                        styles ["title"]
                        label:  _("Bar spacing");
                        xalign: 0;
                      }
                      Label {
                        styles ["sub"]
                        label:  _("Choose the standard or compact bar layout");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    DropDown bar_density {
                      name: "bar_density";
                      valign: center;

                      model: StringList {
                        strings [_("Default"), _("Compact")]
                      };
                    }
                  }

                  Separator {}

                  Box {
                    styles ["field"]
                    orientation: vertical;
                    spacing: 6;

                    Label {
                      styles ["label"]
                      label:  _("Clock");
                      xalign: 0;
                    }

                    Box {
                      spacing: 12;

                      Entry clock {
                        styles ["mono-entry"]
                        name: "clock";
                        width-chars: 20;
                      }

                      Label clock_preview {
                        styles ["readout"]
                        hexpand: true;
                        xalign: 0;
                        ellipsize: end;
                      }
                    }

                    Label {
                      styles ["sub"]
                      label:  _("strftime: %a weekday, %b month, %-d day, %H:%M time");
                      xalign: 0;
                      wrap: true;
                    }
                  }

                  Separator {}

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;

                      Label {
                        styles ["title"]
                        label:  _("Workspaces");
                        xalign: 0;
                      }
                      Label {
                        styles ["sub"]
                        label:  _("Which workspaces each bar shows");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    DropDown ws {
                      name: "ws";
                      valign: center;

                      model: StringList {
                        strings [
                          _("This monitor's"),
                          _("All monitors'"),
                        ]
                      };
                    }
                  }

                  Separator {}

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;

                      Label {
                        styles ["title"]
                        label:  _("Window title");
                        xalign: 0;
                      }
                      Label {
                        styles ["sub"]
                        label:  _("The focused window's title");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Switch title {
                      name: "title";
                      valign: center;
                    }
                  }

                  Separator {}

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;

                      Label {
                        styles ["title"]
                        label:  _("Tray icons");
                        xalign: 0;
                      }
                      Label {
                        styles ["sub"]
                        label:  _("Status icons from apps");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Switch tray {
                      name: "tray";
                      valign: center;
                    }
                  }

                  Separator {}

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;

                      Label {
                        styles ["title"]
                        label:  _("Passwords");
                        xalign: 0;
                      }
                      Label {
                        styles ["sub"]
                        label:  _("Search the password store and copy from it, when there is one");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Switch bar_pass {
                      name: "bar_pass";
                      valign: center;
                    }
                  }
                }
              }


              // [DOCK]
              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    use-markup: true;
                    label:  _("<span alpha='55%'>[</span>DOCK<span alpha='55%'>]</span>");
                  }

                  Label {
                    styles ["section-meta"]
                    label:  _("Apps along the chosen screen edge on each monitor");
                    hexpand: true;
                    xalign: 0;
                    ellipsize: end;
                  }
                }

                Box {
                  styles ["section-body"]
                  orientation: vertical;

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;

                      Label {
                        styles ["title"]
                        label:  _("Show the dock");
                        xalign: 0;
                      }
                      Label {
                        styles ["sub"]
                        label:  _("Pinned apps, then the others with open windows");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Switch dock_enable {
                      name: "dock_enable";
                      valign: center;
                    }
                  }

                  Separator {}

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;

                      Label {
                        styles ["title"]
                        label:  _("Hide automatically");
                        xalign: 0;
                      }
                      Label {
                        styles ["sub"]
                        label:  _("Comes back when the pointer reaches the dock's screen edge");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Switch dock_autohide {
                      name: "dock_autohide";
                      valign: center;
                    }
                  }

                  Separator {}

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;

                      Label {
                        styles ["title"]
                        label:  _("Position");
                        xalign: 0;
                      }
                      Label {
                        styles ["sub"]
                        label:  _("Choose a screen edge for the dock");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    DropDown dock_position {
                      name: "dock_position";
                      valign: center;

                      model: StringList {
                        strings [_("Bottom"), _("Top"), _("Left"), _("Right")]
                      };
                    }
                  }

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;

                      Label {
                        styles ["title"]
                        label:  _("Remove screen edge gaps");
                        xalign: 0;
                      }
                      Label {
                        styles ["sub"]
                        label:  _("Remove the screen-edge margins around the dock and top bar");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Switch dock_flush_bar {
                      name: "dock_flush_bar";
                      valign: center;
                    }
                  }

                  Separator {}

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;

                      Label {
                        styles ["title"]
                        label:  _("Icon size");
                        xalign: 0;
                      }
                    }

                    DropDown dock_size {
                      name: "dock_size";
                      valign: center;

                      model: StringList {
                        strings [
                          _("Smaller"),
                          _("Small"),
                          _("Medium"),
                          _("Large"),
                        ]
                      };
                    }
                  }

                  Separator {}

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;

                      Label {
                        styles ["title"]
                        label:  _("Apps drawer");
                        xalign: 0;
                      }

                      Label {
                        styles ["sub"]
                        label:  _("A button at the end for Clock, Weather, Stocks and Calculator");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Switch dock_drawer {
                      name: "dock_drawer";
                      valign: center;
                    }
                  }
                }
              }

              // [PINNED]
              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
