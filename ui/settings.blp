                  }
                }

                Box {
                  styles ["section-body"]
                  orientation: vertical;

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;

                      Label {
                        styles ["title"]
                        label:  _("Wi-Fi");
                        xalign: 0;
                      }

                      // The network in use, or why there is none.
                      Label wifi_state {
                        styles ["sub"]
                        xalign: 0;
