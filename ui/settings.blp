                    orientation: vertical;
                  }
                }
              }

              // [SCREENSHOTS]
              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    use-markup: true;
                    label:  _("<span alpha='55%'>[</span>SCREENSHOTS<span alpha='55%'>]</span>");
                  }

                  Label {
                    styles ["section-meta"]
                    label:  _("With grim and slurp");
                    hexpand: true;
                    xalign: 0;
                    ellipsize: end;
                  }
                }

                Box {
                  styles ["section-body"]
                  orientation: vertical;

                  // A row per screenshot action, from Go.
                  Box sc_shots {
                    orientation: vertical;
                  }
                }
              }

              // [CUSTOM]
              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    use-markup: true;
                    label:  _("<span alpha='55%'>[</span>CUSTOM<span alpha='55%'>]</span>");
                  }

                  Label {
                    styles ["section-meta"]
                    label:  _("Your own commands");
                    hexpand: true;
                    xalign: 0;
                    ellipsize: end;
                  }
                }

                Box {
                  styles ["section-body"]
                  orientation: vertical;

                  // A row per command, from Go.
                  Box sc_custom {
                    orientation: vertical;
                  }

                  Separator {}

                  Box {
                    styles ["row"]
                    spacing: 8;

                    Entry sc_new_name {
                      name: "sc_new_name";
                      width-chars: 14;
                      placeholder-text:  _("Name");
                    }

                    Entry sc_new_cmd {
                      styles ["mono-entry"]
                      name: "sc_new_cmd";
                      hexpand: true;
                      placeholder-text:  _("Command, e.g. kitty");
                    }

                    Button sc_add {
                      styles ["outlined"]
                      name: "sc_add";
                      label:  _("Add…");
                      tooltip-text:  _("Add, then press its shortcut");
                    }
                  }
                }
              }

              // [HYPRLAND]
              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    use-markup: true;
                    label:  _("<span alpha='55%'>[</span>HYPRLAND<span alpha='55%'>]</span>");
                  }

                  Label {
                    styles ["section-meta"]
                    label:  _("Other shortcuts, from hyprland.conf");
                    hexpand: true;
                    xalign: 0;
                    ellipsize: end;
                  }
                }

                Box {
                  styles ["section-body"]
                  orientation: vertical;

                  // Read-only rows, from Go.
                  Box sc_hypr {
                    orientation: vertical;
                  }
                }
              }
  }
          };

          // The head of the section scrolled under the top edge.
          [overlay]
          Box sticky_shortcuts {
            styles ["section-head", "sticky"]
            spacing: 10;
            valign: start;
            visible: false;
          }
        };
      }

      StackPage {
        name: "wifi";
        title:  _("Wi-Fi");

        child: Overlay {
          child: ScrolledWindow scroll_wifi {
            hscrollbar-policy: never;

            Box {
              styles ["page"]
              orientation: vertical;

              // [WI-FI]
              Box {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    use-markup: true;
                    label:  _("<span alpha='55%'>[</span>WI-FI<span alpha='55%'>]</span>");
                  }

                  Label {
                    styles ["section-meta"]
                    label:  _("This computer");
                    hexpand: true;
                    xalign: 0;
