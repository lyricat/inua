                    ellipsize: end;
                  }
                }

                Box {
                  styles ["section-body"]
                  orientation: vertical;

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;

                      Label {
                        styles ["title"]
                        label:  _("Keep a clipboard history");
                        xalign: 0;
                      }
                      Label {
                        styles ["sub"]
                        label:  _("Text and images you copy, kept on this computer; a password manager's copies are left out");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Switch clip_enable {
                      name: "clip_enable";
                      valign: center;
                    }
                  }

                  Separator {}

                  Box {
                    styles ["field"]
                    orientation: vertical;
                    spacing: 6;

                    Label {
                      styles ["label"]
                      label:  _("Never record copies from");
                      xalign: 0;
                    }

                    // clipboard.sensitive_sources, separated by commas.
                    Entry clip_sensitive {
                      name: "clip_sensitive";
                      styles ["mono-entry"]
                      placeholder-text:  _("pass, keepassxc, …");
                    }

                    Label {
                      styles ["sub"]
                      label:  _("Programs or window classes, separated by commas. The program that ran wl-copy and the focused window are checked; hover over an entry in the history to see where it came from");
                      xalign: 0;
                      wrap: true;
                    }
                  }

                  Separator {}

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;

                      Label {
                        styles ["title"]
                        label:  _("Show in top bar");
                        xalign: 0;
                      }
                      Label {
                        styles ["sub"]
                        label:  _("A button in the status area opens the clipboard history");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Switch clip_bar {
                      name: "clip_bar";
                      valign: center;
                    }
                  }

                  Separator {}

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;

                      Label {
                        styles ["title"]
                        label:  _("Paste on click");
                        xalign: 0;
                      }
                      Label {
                        styles ["sub"]
                        label:  _("Clicking an entry pastes it into the window you were in; off only copies it");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Switch clip_paste {
                      name: "clip_paste";
                      valign: center;
                    }
                  }

                  Separator {}

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;

                      Label {
                        styles ["title"]
                        label:  _("History limit");
                        xalign: 0;
                      }
                      Label {
                        styles ["sub"]
                        label:  _("How many entries it keeps; the oldest go first");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    // Its choices come from Go (showClipboardSettings).
                    DropDown clip_limit {
                      name: "clip_limit";
                      valign: center;
                    }
                  }

                  Separator {}

                  Box {
                    styles ["row"]
                    spacing: 16;

                    Box {
                      orientation: vertical;
                      hexpand: true;
                      valign: center;

                      Label {
                        styles ["title"]
                        label:  _("History storage");
                        xalign: 0;
                      }
                      Label clip_stats {
                        styles ["sub"]
                        label:  _("Loading history…");
                        xalign: 0;
                        wrap: true;
                      }
                    }

                    Button clip_reveal {
                      styles ["outlined"]
                      name: "clip_reveal";
                      label:  _("Reveal");
                      valign: center;
                    }

                    Button clip_clear {
                      styles ["outlined", "danger"]
                      name: "clip_clear";
                      label:  _("Clear the history");
                      valign: center;
                    }
                  }
                }
              }
            }
          };

          [overlay]
          Box sticky_clipboard {
            styles ["section-head", "sticky"]
            spacing: 10;
            valign: start;
            visible: false;
          }
        };
      }

      StackPage {
        name: "keyring";
        title:  _("Keyring");

        // The reads, and beside them the one clicked: what it read, where
        // the secret is in pass, and the process that asked. The trusted
        // apps are a page of their own, there may be many.
        child: Box {
          Stack keyring_pages {
            hexpand: true;
            transition-type: slide_left_right;
            transition-duration: 160;

            StackPage {
              name: "main";

              child: Overlay {
            hexpand: true;

            child: ScrolledWindow scroll_keyring {
              hscrollbar-policy: never;

              Box {
                styles ["page"]
                orientation: vertical;

                // [KEYRING]
                Box {
                  styles ["section"]
                  orientation: vertical;

                  Box {
                    styles ["section-head"]
                    spacing: 10;

                    Box {
                      styles ["mark"]
                      valign: center;
                    }

                    Label {
                      styles ["section-label"]
                      use-markup: true;
                      label:  _("<span alpha='55%'>[</span>KEYRING<span alpha='55%'>]</span>");
                    }

                    Label {
                      styles ["section-meta"]
                      label:  _("Apps' secrets: browsers' keys, Wi-Fi passwords, API keys");
                      hexpand: true;
                      xalign: 0;
                      ellipsize: end;
                    }
                  }

                  Box {
                    styles ["section-body"]
                    orientation: vertical;

                    Box {
                      styles ["row"]
                      spacing: 16;

                      Box {
                        orientation: vertical;
                        hexpand: true;
                        valign: center;

                        Label {
                          styles ["title"]
                          label:  _("Secret Service");
                          xalign: 0;
                        }

                        // Who serves it: inua-keyring, another keyring, or none.
                        Label keyring_state {
                          styles ["sub"]
                          xalign: 0;
                          wrap: true;
                        }
                      }
                    }

                    Separator {}

                    // Unlocked since the first read, or locked.
                    Box {
                      styles ["row"]
                      spacing: 16;

                      Box {
                        orientation: vertical;
                        hexpand: true;
                        valign: center;

                        Label {
                          styles ["title"]
                          label:  _("Unlocked secrets");
                          xalign: 0;
                        }

                        Label keyring_lock_state {
                          styles ["sub"]
                          xalign: 0;
                          wrap: true;
                        }
                      }

                      Button keyring_lock {
                        styles ["outlined"]
                        name: "keyring_lock";
                        label:  _("Lock now");
                        valign: center;
                      }
                    }

                    Separator {}

                    Box {
                      styles ["row"]
                      spacing: 16;

                      Box {
                        orientation: vertical;
                        hexpand: true;
                        valign: center;

                        Label {
                          styles ["title"]
                          label:  _("Lock when unused");
                          xalign: 0;
                        }

                        Label {
                          styles ["sub"]
                          label:  _("It locks with the screen and before suspend, and after this long without a read");
                          xalign: 0;
                          wrap: true;
                        }
                      }

                      DropDown keyring_lock_after {
                        name: "keyring_lock_after";
                        valign: center;

                        model: StringList {
                          strings [
                            _("Never"),
                            _("5 minutes"),
                            _("15 minutes"),
                            _("30 minutes"),
                            _("1 hour"),
                            _("4 hours"),
                          ]
                        };
                      }
                    }

                    Separator {}

                    Box {
                      styles ["row"]
                      spacing: 16;

                      Box {
                        orientation: vertical;
                        hexpand: true;
                        valign: center;

                        Label {
                          styles ["title"]
                          label:  _("With no one to ask");
                          xalign: 0;
                        }

                        Label {
                          styles ["sub"]
                          label:  _("A read by an app not trusted with the secret, while the inua shell is not running");
                          xalign: 0;
                          wrap: true;
                        }
                      }

                      DropDown keyring_untrusted {
                        name: "keyring_untrusted";
                        valign: center;

                        model: StringList {
                          strings [
                            _("Allowed"),
                            _("Denied"),
                          ]
                        };
                      }
                    }

                    Separator {}

                    Box {
                      styles ["row"]
                      spacing: 16;

                      Box {
                        orientation: vertical;
                        hexpand: true;
                        valign: center;

                        Label {
                          styles ["title"]
                          label:  _("Tell when an app reads a secret");
                          xalign: 0;
                        }
                        Label {
                          styles ["sub"]
                          label:  _("A notification for each app's first read since inua-keyring started");
                          xalign: 0;
                          wrap: true;
                        }
                      }

                      Switch keyring_notify {
                        name: "keyring_notify";
                        valign: center;
                      }
                    }
                  }
                }

                // [TRUSTED APPS]
                Box {
                  styles ["section"]
                  orientation: vertical;

                  Box {
                    styles ["section-head"]
                    spacing: 10;

                    Box {
                      styles ["mark"]
                      valign: center;
                    }

                    Label {
                      styles ["section-label"]
                      use-markup: true;
                      label:  _("<span alpha='55%'>[</span>TRUSTED APPS<span alpha='55%'>]</span>");
                    }

                    Label {
                      styles ["section-meta"]
                      label:  _("Apps that read a secret without asking; any other app is asked about first");
                      hexpand: true;
                      xalign: 0;
                      ellipsize: end;
                    }
                  }

                  Box {
                    styles ["section-body"]
                    orientation: vertical;

                    // How many, or why the list is not trusted; opens the
                    // page of them.
                    Button keyring_trusted_open {
                      styles ["keyring-read"]
                      name: "keyring_trusted_open";

                      Box {
                        styles ["row"]
                        spacing: 16;

                        Box {
                          orientation: vertical;
                          hexpand: true;
                          valign: center;

                          Label {
                            styles ["title"]
                            label:  _("Trusted apps");
                            xalign: 0;
                          }

                          Label keyring_trusted_sum {
                            styles ["sub"]
                            xalign: 0;
                            wrap: true;
                          }
                        }

                        Image {
                          icon-name: "go-next-symbolic";
                          valign: center;
                        }
                      }
                    }
                  }
                }

                // [READS]
                Box {
                  styles ["section"]
                  orientation: vertical;

                  Box {
                    styles ["section-head"]
                    spacing: 10;

                    Box {
                      styles ["mark"]
                      valign: center;
                    }

                    Label {
                      styles ["section-label"]
                      use-markup: true;
                      label:  _("<span alpha='55%'>[</span>READS<span alpha='55%'>]</span>");
                    }

                    Label {
                      styles ["section-meta"]
                      label:  _("Every secret inua-keyring handed out and passphrase asked for, newest first");
                      hexpand: true;
                      xalign: 0;
                      ellipsize: end;
                    }
                  }

                  Box {
                    styles ["section-body"]
                    orientation: vertical;

                    // Filled from Go: a row for each read, a process reading
                    // the same secret again counted on one row.
                    Box keyring_reads {
                      orientation: vertical;
                    }

                    Label keyring_none {
                      styles ["sub"]
                      label:  _("No app has read a secret yet.");
                      xalign: 0;
                      visible: false;
                    }

                    Box {
                      styles ["row"]
                      spacing: 16;

                      Label {
                        hexpand: true;
                      }

                      Button keyring_refresh {
                        styles ["outlined"]
                        name: "keyring_refresh";
                        label:  _("Refresh");
                        valign: center;
                      }
                    }
                  }
                }
              }
            };

            // The head of the section scrolled under the top edge.
            [overlay]
            Box sticky_keyring {
              styles ["section-head", "sticky"]
              spacing: 10;
              valign: start;
              visible: false;
            }
              };
            }

            // The trusted apps, filtered by what is typed.
            StackPage {
              name: "trusted";

              child: Box {
                styles ["page"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Button keyring_trusted_back {
                    styles ["plain"]
                    name: "keyring_trusted_back";
                    icon-name: "go-previous-symbolic";
                    tooltip-text:  _("Back");
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    use-markup: true;
                    label:  _("<span alpha='55%'>[</span>TRUSTED APPS<span alpha='55%'>]</span>");
                  }

                  Label keyring_trusted_total {
                    styles ["section-meta"]
                    hexpand: true;
                    xalign: 0;
                    ellipsize: end;
                  }
                }

                // The list was changed outside inua-keyring: nothing in it
                // is trusted until the user trusts it again.
                Box keyring_problem {
                  styles ["row", "keyring-problem"]
                  spacing: 16;
                  visible: false;

                  Box {
                    orientation: vertical;
                    hexpand: true;
                    valign: center;

                    Label {
                      styles ["title"]
                      label:  _("The list is not trusted");
                      xalign: 0;
                    }

                    Label keyring_problem_text {
                      styles ["sub"]
                      xalign: 0;
                      wrap: true;
                    }
                  }

                  Button keyring_reseal {
                    styles ["outlined"]
                    name: "keyring_reseal";
                    label:  _("Trust this list again");
                    valign: center;
                  }
                }

                ScrolledWindow {
                  hscrollbar-policy: never;
                  vexpand: true;

                  Box {
                    orientation: vertical;
                    margin-top: 12;

                    // Paths whose programs read every secret, whatever
                    // their hash: for apps that change every day. Added
                    // only once inua-keyring's own question says so.
                    Box {
                      styles ["section"]
                      orientation: vertical;

                      Box {
                        styles ["section-head"]
                        spacing: 10;

                        Box {
                          styles ["mark"]
                          valign: center;
                        }

                        Label {
                          styles ["section-label"]
                          use-markup: true;
                          label:  _("<span alpha='55%'>[</span>ALLOWED PATHS<span alpha='55%'>]</span>");
                        }

                        Label keyring_paths_count {
                          styles ["section-meta"]
                          hexpand: true;
                          xalign: 0;
                          ellipsize: end;
                        }
                      }

                      Box {
                        styles ["section-body"]
                        orientation: vertical;
                        spacing: 8;

                        Label {
                          styles ["sub"]
                          label:  _("Any program at one of these paths reads every secret without asking, even after it changes: for an app that updates every day. inua-keyring asks you before a path is added.");
                          xalign: 0;
                          wrap: true;
                          margin-top: 8;
                        }

                        // Filled from Go: a row for each path.
                        Box keyring_paths {
                          orientation: vertical;
                        }

                        Box {
                          spacing: 8;

                          Entry keyring_path_entry {
                            styles ["mono-entry"]
                            hexpand: true;
                            placeholder-text:  _("A path; * within a folder: ~/.local/share/app/versions/*");
                          }

                          Button keyring_path_add {
                            styles ["outlined"]
                            name: "keyring_path_add";
                            label:  _("Allow path");
                          }
                        }

                        Label keyring_path_note {
                          styles ["sub"]
                          xalign: 0;
                          wrap: true;
                          visible: false;
                        }
                      }
                    }

                    // Each app trusted with a secret.
                    Box {
                      styles ["section"]
                      orientation: vertical;

                      Box {
                        styles ["section-head"]
                        spacing: 10;

                        Box {
                          styles ["mark"]
                          valign: center;
                        }

                        Label {
                          styles ["section-label"]
                          use-markup: true;
                          label:  _("<span alpha='55%'>[</span>APPS<span alpha='55%'>]</span>");
                        }

                        Label keyring_trusted_count {
                          styles ["section-meta"]
                          hexpand: true;
                          xalign: 0;
                          ellipsize: end;
                        }

                        SearchEntry keyring_trusted_filter {
                          placeholder-text:  _("Filter by app, program or secret");
                          width-chars: 28;
                          valign: center;
                        }
                      }

                      Box {
                        styles ["section-body"]
                        orientation: vertical;

                        // Filled from Go: a row for each app and secret.
                        Box keyring_trusted {
                          orientation: vertical;
                        }

                        Label keyring_trusted_none {
                          styles ["sub"]
                          xalign: 0;
                          wrap: true;
                          margin-top: 12;
                          visible: false;
                        }
                      }
                    }
                  }
                }
              };
            }
          }

          Revealer keyring_detail {
            hexpand: false;
            transition-type: slide_left;
            transition-duration: 160;
            reveal-child: false;

            Box {
              styles ["side-panel"]
              orientation: vertical;
              width-request: 300;

              Box {
                styles ["side-head"]
                spacing: 8;

                // [READ], or [PASSPHRASE] for one inua-pinentry asked for.
                Label keyring_detail_head {
                  styles ["section-label"]
                  use-markup: true;
                  label:  _("<span alpha='55%'>[</span>READ<span alpha='55%'>]</span>");
                  hexpand: true;
                  xalign: 0;
                }

                Button keyring_detail_close {
                  styles ["plain"]
                  name: "keyring_detail_close";
                  icon-name: "window-close-symbolic";
                  tooltip-text:  _("Close");
                  valign: center;
                }
              }

              ScrolledWindow {
                hscrollbar-policy: never;
                vexpand: true;

                // Filled from Go: a field for each thing known of the read.
                Box keyring_detail_fields {
                  styles ["side-body"]
                  orientation: vertical;
                  spacing: 14;
                }
              }
            }
          }
        };
      }

      StackPage {
        name: "shortcuts";
        title:  _("Shortcuts");

        child: Overlay {
          child: ScrolledWindow scroll_shortcuts {
            hscrollbar-policy: never;

            Box {
              styles ["page"]
              orientation: vertical;

              // Why these settings do nothing: hyprland.conf does not source
              // inua.conf, or sets them again after it.
              Label sc_warn {
                styles ["warn"]
                visible: false;
                xalign: 0;
                wrap: true;
              }

              // While recording: what to press.
              Label sc_recording {
                styles ["recording"]
