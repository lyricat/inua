                  Label wifi_nearby_meta {
                    styles ["section-meta"]
                    label:  _("Searching…");
                    hexpand: true;
                    xalign: 0;
                    ellipsize: end;
                  }
                }

                Box wifi_nearby {
                  styles ["section-body"]
                  orientation: vertical;
                }
              }
            }
          };

          // The head of the section scrolled under the top edge.
          [overlay]
          Box sticky_wifi {
            styles ["section-head", "sticky"]
            spacing: 10;
            valign: start;
            visible: false;
          }
        };
      }

      StackPage {
