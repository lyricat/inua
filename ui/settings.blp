              // [NEARBY]: the others in range, found while the page is shown.
              Box wifi_nearby_section {
                styles ["section"]
                orientation: vertical;

                Box {
                  styles ["section-head"]
                  spacing: 10;

                  Box {
                    styles ["mark"]
                    valign: center;
                  }

                  Label {
                    styles ["section-label"]
                    use-markup: true;
                    label:  _("<span alpha='55%'>[</span>NEARBY<span alpha='55%'>]</span>");
