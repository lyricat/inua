#!/bin/sh
# Start Inua once, then replace this process with Wayfire.
set -eu

for program in inua-shell inua wayfire; do
    if ! command -v "$program" >/dev/null 2>&1; then
        echo "inua-wayfire-session: $program is not on PATH; install Inua and Wayfire first" >&2
        exit 127
    fi
done

config_dir=${XDG_CONFIG_HOME:-"$HOME/.config"}
config_file=$config_dir/wayfire.ini
if [ ! -r "$config_file" ]; then
    echo "inua-wayfire-session: missing $config_file; copy config/session/wayfire.ini there" >&2
    exit 1
fi

# Give the Wayfire shell its own control socket. The socket listener rejects
# a second launcher attempt that is still active for this session.
instance=wayfire
INUA_INSTANCE=$instance export INUA_INSTANCE
inua-shell -n "$instance" &
shell_pid=$!
cleanup() {
    kill "$shell_pid" 2>/dev/null || true
    wait "$shell_pid" 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM

# If GTK startup fails immediately, do not enter a shell-less session.
sleep 0.2
if ! kill -0 "$shell_pid" 2>/dev/null; then
    wait "$shell_pid" || status=$?
    echo "inua-wayfire-session: inua-shell exited before Wayfire startup (${status:-1})" >&2
    exit "${status:-1}"
fi

trap - EXIT HUP INT TERM
exec wayfire -c "$config_file"
