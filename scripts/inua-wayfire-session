#!/bin/sh
# Start Wayfire; its autostart launches Inua after the compositor is ready.
set -eu

for program in inua-shell inua wayfire; do
    if ! command -v "$program" >/dev/null 2>&1; then
        echo "inua-wayfire-session: $program is not on PATH; install Inua and Wayfire first" >&2
        exit 127
    fi
done

config_dir=${XDG_CONFIG_HOME:-"$HOME/.config"}
config_file=$config_dir/wayfire.ini
sample=${INUA_WAYFIRE_CONFIG:-}
if [ -z "$sample" ]; then
	script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
	sample=$script_dir/../config/session/wayfire.ini
fi
if [ ! -e "$config_file" ]; then
	if [ ! -r "$sample" ]; then
		echo "inua-wayfire-session: missing $config_file and Wayfire sample $sample" >&2
		exit 1
	fi
	install -D -m644 "$sample" "$config_file"
fi
if [ ! -r "$config_file" ]; then
	echo "inua-wayfire-session: cannot read $config_file" >&2
	exit 1
fi

# The autostart entry starts Inua after Wayfire has created its display and IPC socket.
XDG_CURRENT_DESKTOP=Wayfire:Inua
export XDG_CURRENT_DESKTOP
INUA_INSTANCE=wayfire
export INUA_INSTANCE
exec wayfire -c "$config_file"
